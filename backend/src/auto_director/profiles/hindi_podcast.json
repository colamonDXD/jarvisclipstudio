{
  "niche": "hindi_podcast",
  "pacing": {
    "target_cuts_per_min": [10, 16],
    "silence_trim_aggressive": true,
    "min_shot_sec": 3.75,
    "max_shot_sec": 6.0
  },
  "transitions": {
    "default": "hard_cut",
    "duration_sec": 0.05,
    "on_topic_change": "hard_cut",
    "on_punchline": "hard_cut"
  },
  "zooms": {
    "punch_in_scale": 1.15,
    "punch_in_trigger": "emphasis",
    "ken_burns": false
  },
  "captions": {
    "preset_id": "hormozi",
    "words_per_line": 3,
    "position": "bottom"
  },
  "overlays": {
    "info_cards": true,
    "lower_thirds": true,
    "reference_images": "open_web",
    "ref_image_at_entity_mentions": true
  },
  "broll": {
    "enabled": true,
    "source": "pexels",
    "density_per_min": 0.5
  },
  "audio": {
    "music_mood": "calm",
    "music_volume_0_to_1": 0.15,
    "ducking_db": -12.0,
    "sfx_from_user_library": true
  },
  "color": {
    "lut": "none"
  },
  "hook": {
    "title_style": "statement",
    "title_seconds": 2.0
  }
}
