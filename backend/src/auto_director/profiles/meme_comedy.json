{
  "niche": "meme_comedy",
  "pacing": {
    "target_cuts_per_min": [10, 15],
    "silence_trim_aggressive": true,
    "min_shot_sec": 4.0,
    "max_shot_sec": 6.0
  },
  "transitions": {
    "default": "cut",
    "duration_sec": 0.0,
    "on_topic_change": "cut",
    "on_punchline": "zoom_bounce"
  },
  "zooms": {
    "punch_in_scale": 1.35,
    "punch_in_trigger": "punchline",
    "ken_burns": false
  },
  "captions": {
    "preset_id": "large_centre_pop",
    "words_per_line": 3,
    "position": "center"
  },
  "overlays": {
    "info_cards": false,
    "lower_thirds": false,
    "reference_images": "off",
    "ref_image_at_entity_mentions": false
  },
  "broll": {
    "enabled": false,
    "source": "off",
    "density_per_min": 0.0
  },
  "audio": {
    "music_mood": "none",
    "music_volume_0_to_1": 0.0,
    "ducking_db": 0.0,
    "sfx_from_user_library": true
  },
  "color": {
    "lut": "punchy"
  },
  "hook": {
    "title_style": "contrast",
    "title_seconds": 3.0
  }
}