+@router.get("/transitions/library")
+async def get_transition_library(family: str | None = None):
+    """List the extended transition catalogue, newest library beside built-ins.
+
+    Public on purpose, matching ``GET /transitions``: the picker needs the
+    list before a user has a task. ``TRANSITION_LIBRARY_API=off`` removes
+    both this route and the preview route.
+    """
+    if not transition_preview_enabled():
+        raise HTTPException(status_code=404, detail="Not found")
+
+    entries = sorted(TRANSITIONS.values(), key=lambda item: (item.family, item.name))
+    if family is not None:
+        entries = [entry for entry in entries if entry.family == family]
+
+    return [
+        {
+            "name": entry.name,
+            "family": entry.family,
+            "description": entry.description,
+            "duration_default": PREVIEW_TRANSITION_SECONDS,
+            "preview_url": f"/transitions/library/{entry.name}/preview.mp4",
+        }
+        for entry in entries
+    ]
+
+
+@router.get("/transitions/library/{name}/preview.mp4")
+async def get_transition_library_preview(name: str):
+    """Serve a cached 1.2 s preview, rendering it on the first request."""
+    if not transition_preview_enabled():
+        raise HTTPException(status_code=404, detail="Not found")
+
+    # Registry membership is the only accepted name. The explicit ``Path``
+    # check is belt-and-braces for callers that bypass FastAPI's routing.
+    if name not in TRANSITIONS or Path(name).name != name:
+        raise HTTPException(status_code=404, detail="Transition not found")
+
+    output = preview_cache_path(get_config().temp_dir, name)
+    if not output.is_file() or output.stat().st_size == 0:
+        try:
+            await run_in_thread(render_transition_preview, name, output)
+        except Exception as error:
+            logger.error("Error rendering transition preview %s: %s", name, error)
+            raise HTTPException(
+                status_code=500, detail=f"Error rendering transition preview: {error}"
+            )
+
+    return FileResponse(
+        path=str(output),
+        media_type="video/mp4",
+        headers={"Cache-Control": "public, max-age=86400"},
+    )
+
+
