+"""Quick live preview: a vertical clip of a candidate window in seconds.
+
+Speed over polish (the final clip goes through the normal pipeline): the
+buffer window is trimmed to the candidate span, centre-cropped to 9:16 at
+720x1280, encoded with x264 ultrafast. The final render later re-uses the
+same window file with the full framing/captions engine.
+"""
+from __future__ import annotations
+
+import subprocess
+from pathlib import Path
+from typing import Dict, Optional
+
+
+def render_preview(window: Dict, out_path: Path, max_len: float = 60.0) -> Optional[Path]:
+    out_path = Path(out_path)
+    out_path.parent.mkdir(parents=True, exist_ok=True)
+    duration = min(float(window["duration"]), max_len)
+    cmd = ["ffmpeg", "-v", "error", "-y", "-ss", f"{float(window['offset']):.3f}", "-i", str(window["path"]),
+           "-t", f"{duration:.3f}",
+           "-vf", "crop='min(iw,ih*9/16)':ih,scale=720:1280:flags=bilinear,setsar=1",
+           "-c:v", "libx264", "-preset", "ultrafast", "-crf", "26", "-c:a", "aac", "-b:a", "128k",
+           "-movflags", "+faststart", str(out_path)]
+    result = subprocess.run(cmd, capture_output=True, text=True)
+    return out_path if result.returncode == 0 and out_path.is_file() else None
diff --git a/backend/src/live/reaction_scan.py b/backend/src/live/reaction_scan.py
new file mode 100644
index 0000000..71fbd5d
--- /dev/null
+++ b/backend/src/live/reaction_scan.py
@@ -0,0 +1,64 @@
+"""Run the existing streamer reaction picker on rolling windows of the live buffer.
+
+Plain loudness cannot find reactions in a stream whose game audio is
+constantly loud (fake-live demo on the Kai sample: max loudness z 1.6, no
+candidate). The Phase 2 picker (auto_director.reaction_moments) uses the mic
+channel, pitch/scream, laughter, facecam activity and game events, and
+names the on-screen trigger. Every ``scan_every`` seconds the last
+``window_sec`` of the buffer is cut (stream copy) and analysed; its moments
+come back on the wall clock for the fuser. Cost on this laptop (CPU):
+~110 s per 170 s window, so a 120 s window every 45-60 s keeps up.
+"""
+from __future__ import annotations
+
+import logging
+from pathlib import Path
+from typing import Any, Dict, List
+
+from .buffer import SegmentBuffer
+
+logger = logging.getLogger(__name__)
+
+
+def _mmss(value: Any) -> float:
+    parts = [float(p) for p in str(value).split(":")]
+    seconds = 0.0
+    for part in parts:
+        seconds = seconds * 60 + part
+    return seconds
+
+
+def scan_reactions(buffer: SegmentBuffer, work_dir: Path, window_sec: float = 120.0,
+                   now: float | None = None, target_count: int = 3) -> List[Dict[str, Any]]:
+    """Reaction moments in the last ``window_sec`` of the buffer, on the wall clock."""
+    from ..auto_director.reaction_moments import select_streamer_moments
+
+    span = buffer.span()
+    if not span:
+        return []
+    end = span[1] if now is None else min(now, span[1])
+    window = buffer.cut_window(max(span[0], end - window_sec), end, Path(work_dir) / "scan_window.mp4")
+    if not window or window["duration"] < 20:
+        return []
+    try:
+        moments = select_streamer_moments(window["path"], window["offset"] + window["duration"],
+                                          target_count=target_count, clip_seconds=30.0)
+    except Exception as exc:
+        logger.warning("Live reaction scan failed: %s", exc)
+        return []
+    base = window["file_start_wall"]
+    out = []
+    for m in moments:
+        if m.get("hook_type") == "silent_action":
+            continue  # "something happens but the streamer does not react": not a clip
+        start, end_m = _mmss(m["start_time"]), _mmss(m["end_time"])
+        if end_m <= window["offset"]:
+            continue
+        # The picker's window keeps a few seconds before the reaction; the
+        # reaction itself is near the start of its window's last third.
+        onset = start + (end_m - start) * 0.55
+        out.append({"onset": base + onset, "start": base + start, "end": base + end_m,
+                    "score": float(m.get("fused_score") or m.get("virality_score") or 50) / 100.0,
+                    "reason": m.get("reasoning") or m.get("reason") or "streamer reaction",
+                    "hook_title": m.get("hook_title")})
+    return out
diff --git a/backend/src/live/signals.py b/backend/src/live/signals.py
new file mode 100644
index 0000000..0482c7a
--- /dev/null
+++ b/backend/src/live/signals.py
@@ -0,0 +1,105 @@
+"""Live audio excitement: loudness per half second, against a rolling baseline.
+
+Each new buffer segment is measured once (two cheap ffmpeg passes: overall
+RMS and >1 kHz RMS, the band shouting and laughter push up most), and the
+points are kept on the wall clock. ``zscores`` compares recent points with
+the robust baseline (median / MAD) of the last ``baseline_sec`` excluding
+the most recent ``exclude_recent_sec``, so a long exciting stretch does not
+become its own baseline straight away.
+"""
+from __future__ import annotations
+
+import re
+import subprocess
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Dict, List, Optional, Tuple
+
+import numpy as np
+
+from .buffer import Segment, SegmentBuffer
+
+STEP_SEC = 0.5
+SR = 16000
+_RMS_RE = re.compile(r"lavfi\.astats\.Overall\.RMS_level=(-?[\d.]+|-inf)")
+
+
+def _levels(path: Path, highpass: bool) -> List[float]:
+    chain = (f"aresample={SR},{'highpass=f=1000,' if highpass else ''}"
+             f"asetnsamples={int(SR * STEP_SEC)},astats=metadata=1:reset=1,"
+             "ametadata=print:key=lavfi.astats.Overall.RMS_level:file=-")
+    out = subprocess.run(["ffmpeg", "-v", "error", "-i", str(path), "-vn", "-af", chain, "-f", "null", "-"],
+                         capture_output=True, text=True).stdout
+    values = []
+    for match in _RMS_RE.finditer(out):
+        raw = match.group(1)
+        values.append(-120.0 if raw == "-inf" else max(-120.0, float(raw)))
+    return values
+
+
+@dataclass
+class AudioTrack:
+    baseline_sec: float = 300.0
+    exclude_recent_sec: float = 10.0
+    times: List[float] = field(default_factory=list)
+    level: List[float] = field(default_factory=list)
+    high: List[float] = field(default_factory=list)
+    _seen: set = field(default_factory=set)
+
+    def add_segment(self, seg: Segment) -> int:
+        key = str(seg.path)
+        if key in self._seen:
+            return 0
+        self._seen.add(key)
+        lv, hi = _levels(seg.path, False), _levels(seg.path, True)
+        n = min(len(lv), len(hi))
+        for i in range(n):
+            self.times.append(seg.start + i * STEP_SEC)
+            self.level.append(lv[i])
+            self.high.append(hi[i])
+        return n
+
+    def update(self, buffer: SegmentBuffer) -> int:
+        added = 0
+        for seg in buffer.segments():
+            added += self.add_segment(seg)
+        order = np.argsort(self.times)
+        self.times = [self.times[i] for i in order]
+        self.level = [self.level[i] for i in order]
+        self.high = [self.high[i] for i in order]
+        return added
+
+    def zscores(self, now: Optional[float] = None) -> List[Tuple[float, float]]:
+        """[(wall time, excitement z)]: each point against the baseline BEFORE it.
+
+        Causal: a point's z uses the ``baseline_sec`` that preceded it
+        (excluding the last ``exclude_recent_sec``), so a later change of
+        level never rewrites history (fake-live demo: a moment at 4 s only
+        "appeared" 341 s later when old points were re-scored against the
+        current baseline). Computed once per point and cached. z = max of
+        the level z and the >1 kHz z; 0 until 20 baseline points exist.
+        """
+        t = np.asarray(self.times)
+        lv, hi = np.asarray(self.level), np.asarray(self.high)
+        cache = getattr(self, "_zcache", {})
+        out: List[Tuple[float, float]] = []
+        for i in range(len(t)):
+            key = (float(t[i]),)
+            if key in cache:
+                out.append((float(t[i]), cache[key]))
+                continue
+            lo = np.searchsorted(t, t[i] - self.baseline_sec)
+            hi_idx = np.searchsorted(t, t[i] - self.exclude_recent_sec)
+            if hi_idx - lo < 20:
+                z = 0.0
+            else:
+                z = 0.0
+                for series in (lv, hi):
+                    ref = series[lo:hi_idx]
+                    med = float(np.median(ref))
+                    mad = float(np.median(np.abs(ref - med))) * 1.4826
+                    z = max(z, (float(series[i]) - med) / max(mad, 1.5))
+            cache[key] = z
+            out.append((float(t[i]), z))
+        self._zcache = cache
+        return out
diff --git a/backend/tests/unit/test_live_fuser.py b/backend/tests/unit/test_live_fuser.py
new file mode 100644
index 0000000..ea4a11a
--- /dev/null
+++ b/backend/tests/unit/test_live_fuser.py
@@ -0,0 +1,97 @@
+"""Live MVP: the fuser only clips moments the stream itself confirms."""
+from __future__ import annotations
+
+from src.live.fuser import FuserConfig, fuse
+
+
+def _audio(events, length=600.0, step=0.5):
+    """Calm z ~0.2 with excitement bumps: events = [(start, end, z)]."""
+    out, t = [], 0.0
+    while t < length:
+        v = 0.2
+        for a, b, z in events:
+            if a <= t < b:
+                v = z
+        out.append((t, v))
+        t += step
+    return out
+
+
+def test_chat_spike_with_audio_reaction_becomes_a_clip_with_preroll_and_payoff():
+    audio = _audio([(100.0, 106.0, 5.0)])
+    spikes = [{"peak": 110.0, "score": 0.9}]  # chat reacts ~10 s after the scream
+    [cand] = fuse(spikes, audio)
+    assert cand.sources == ["chat", "audio"]
+    assert cand.onset == 100.0
+    assert cand.start == 80.0  # 20 s pre-roll: the stimulus before the reaction
+    assert 106.0 <= cand.end <= 106.0 + 6.0 + 0.5  # settles, then the post-roll
+    assert cand.score > 0.8
+
+
+def test_chat_alone_never_makes_a_clip():
+    assert fuse([{"peak": 300.0, "score": 1.0}], _audio([])) == []
+
+
+def test_rejected_spikes_are_ignored_even_with_audio():
+    audio = _audio([(100.0, 103.0, 3.0)])
+    assert fuse([{"peak": 108.0, "score": 1.0, "rejected": "spam_or_bots"}], audio) == []
+
+
+def test_strong_audio_alone_is_a_lower_score_candidate():
+    [cand] = fuse([], _audio([(200.0, 203.0, 6.0)]))
+    assert cand.sources == ["audio"] and cand.score < 0.6
+
+
+def test_one_event_is_one_clip():
+    audio = _audio([(100.0, 104.0, 6.0)])
+    spikes = [{"peak": 108.0, "score": 0.8}, {"peak": 112.0, "score": 0.6}]
+    cands = fuse(spikes, audio)
+    assert len(cands) == 1 and set(cands[0].sources) == {"chat", "audio"}
+
+
+def test_pre_and_post_roll_are_configurable_and_length_is_capped():
+    audio = _audio([(100.0, 190.0, 5.0)])  # very long excitement
+    cfg = FuserConfig(preroll=30.0, postroll=10.0, max_len=45.0)
+    [cand] = fuse([{"peak": 105.0, "score": 0.9}], audio, cfg)
+    assert cand.start == 70.0 and cand.end == 115.0
+
+
+def test_visual_veto_drops_a_candidate():
+    audio = _audio([(100.0, 104.0, 6.0)])
+    cands = fuse([{"peak": 108.0, "score": 0.9}], audio,
+                 visual_confirm=lambda c: (False, "dark screen, nothing happening"))
+    assert cands == []
+
+
+def test_reaction_moments_are_candidates_and_chat_after_them_boosts():
+    reactions = [{"onset": 120.0, "start": 114.0, "end": 125.0, "score": 0.72, "reason": "vocal burst after a flash"}]
+    [alone] = fuse([], _audio([]), reactions=reactions)
+    assert alone.sources == ["reaction"] and alone.score == 0.72
+    assert alone.start == 100.0  # pre-roll reaches back to the stimulus
+    [boosted] = fuse([{"peak": 128.0, "score": 1.0}], _audio([]), reactions=reactions)
+    assert boosted.sources == ["reaction", "chat"] and boosted.score > 0.72
+    # a spike long after the reaction does not count as its confirmation
+    [late] = fuse([{"peak": 200.0, "score": 1.0}], _audio([]), reactions=reactions)
+    assert late.sources == ["reaction"]
+
+
+def test_weak_picker_items_are_not_clips():
+    weak = [{"onset": 50.0, "start": 45.0, "end": 60.0, "score": 0.12, "reason": "event, no reaction"}]
+    assert fuse([], _audio([]), reactions=weak) == []
+
+
+def test_audio_z_is_causal_and_never_rewritten():
+    from src.live.signals import AudioTrack
+
+    track = AudioTrack(baseline_sec=60.0, exclude_recent_sec=5.0)
+    for i in range(200):  # 100 s quiet at -40 dB, then everything gets louder
+        track.times.append(i * 0.5)
+        level = -40.0 + (0.5 if i % 2 else -0.5)
+        track.level.append(level)
+        track.high.append(level - 10)
+    track.times.append(100.0); track.level.append(-10.0); track.high.append(-20.0)  # a shout
+    first = dict(track.zscores())
+    assert first[100.0] > 5.0
+    for i in range(201, 400):  # the stream stays loud afterwards
+        track.times.append(i * 0.5); track.level.append(-10.0); track.high.append(-20.0)
+    assert dict(track.zscores())[100.0] == first[100.0]  # history is not re-scored
