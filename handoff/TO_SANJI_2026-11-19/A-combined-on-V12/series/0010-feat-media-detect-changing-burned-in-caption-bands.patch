+        "texture": _build(
+            directory, "texture", _motion(), "noise=alls=45:allf=t"
+        ),
+        "moving_static": _build(
+            directory,
+            "moving_static",
+            _motion(),
+            _caption("@channel", 8, 26),
+        ),
+    }
+
+
+@requires_ffmpeg
+def test_finds_a_changing_bottom_band(clips):
+    band = detect_burned_caption_band(
