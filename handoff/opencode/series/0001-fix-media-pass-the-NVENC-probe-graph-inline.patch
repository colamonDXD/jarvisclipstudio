 from pathlib import Path
 
 SHIM_SOURCE = r"""#!/usr/bin/env python3
@@ -39,6 +51,8 @@ with (state / "calls.log").open("a") as fh:
     fh.write(json.dumps(sys.argv) + "\n")
 scenario = (state / "scenario").read_text().strip()
 tool = Path(sys.argv[0]).name
