+#!/usr/bin/env python3
+"""Render a proof reel for the xfade transition catalogue.
+
+For every name in ``backend/src/media/edl_render.py``'s
+``XFADE_TRANSITIONS`` this script renders a two-shot join -- two
+distinct, labelled 1080x1920 test cards, 0.5 s transition, FFmpeg's
+``xfade`` -- then probes the output, extracts the midpoint frame,
+computes a downscaled grey signature, flags variants whose signatures
+are near-identical, writes one contact sheet per transition family, and
+prints a table of name / rendered OK / duration / distinct-from.
+
+The catalogue is read from the source file with ``ast`` on purpose: the
+render module imports the whole media stack and this tool must not need
+the app's environment. Nothing here changes product code.
+
+Usage (from the repository root):
+
+    python tools/transitions-proof/make_reel.py
+    python tools/transitions-proof/make_reel.py --only fade,wipeleft --out .\tmp\proof
+
+Exit code is 1 when any transition fails to render, so CI can use it.
+"""
+
+from __future__ import annotations
+
+import argparse
+import ast
+import base64
+import json
+import math
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+EDL_RENDER = REPO_ROOT / "backend" / "src" / "media" / "edl_render.py"
+
+WIDTH = 1080
+HEIGHT = 1920
+FPS = 30
+CARD_SECONDS = 1.2
+TRANSITION_SECONDS = 0.5
+OFFSET_SECONDS = CARD_SECONDS - TRANSITION_SECONDS
+MIDPOINT_SECONDS = OFFSET_SECONDS + TRANSITION_SECONDS / 2.0
+MIDPOINT_FRAME = int(OFFSET_SECONDS * FPS + TRANSITION_SECONDS * FPS / 2.0)
+# 25% / 50% / 75% through the 15-frame transition.
+SEQUENCE_FRAMES = (
+    int(OFFSET_SECONDS * FPS + TRANSITION_SECONDS * FPS * 0.25),
+    int(OFFSET_SECONDS * FPS + TRANSITION_SECONDS * FPS * 0.50),
+    int(OFFSET_SECONDS * FPS + TRANSITION_SECONDS * FPS * 0.75),
+)
+SIGNATURE_SIZE = 32
+SEQUENCE_SIGNATURE_SIZE = 32
+EXPECTED_DURATION = CARD_SECONDS * 2 - TRANSITION_SECONDS
+
+# Midpoint signatures closer than this (mean absolute difference on the
+# 0..255 grey samples) are reported as near-identical: at the midpoint
+# these variants look the same.
+MIDPOINT_NEAR_IDENTICAL = 1.0
+# Three-frame signatures closer than this are reported as the same
+# variant. This catches fade/fadefast/fadeslow, whose midpoint is shared
+# but whose timing differs.
+SEQUENCE_NEAR_IDENTICAL = 1.0
+
+FAMILIES = {
+    "fade-blend": [
+        "fade", "fadeblack", "fadewhite", "fadegrays", "fadefast",
+        "fadeslow", "dissolve",
+    ],
+    "pixel-blur-zoom": ["pixelize", "hblur", "distance", "zoomin"],
+    "wipe-edge": [
+        "wipeleft", "wiperight", "wipeup", "wipedown",
+        "wipetl", "wipetr", "wipebl", "wipebr",
+    ],
+    "slide": ["slideleft", "slideright", "slideup", "slidedown"],
+    "smooth": ["smoothleft", "smoothright", "smoothup", "smoothdown"],
+    "circle-radial": [
+        "circlecrop", "circleopen", "circleclose", "radial", "rectcrop",
+    ],
+    "open-close": ["vertopen", "vertclose", "horzopen", "horzclose"],
+    "diagonal": ["diagtl", "diagtr", "diagbl", "diagbr"],
+    "slice": ["hlslice", "hrslice", "vuslice", "vdslice"],
+    "squeeze": ["squeezeh", "squeezev"],
+    "wind": ["hlwind", "hrwind", "vuwind", "vdwind"],
+    "cover-reveal": [
+        "coverleft", "coverright", "coverup", "coverdown",
+        "revealleft", "revealright", "revealup", "revealdown",
+    ],
+}
+
+
+def load_transitions(path: Path) -> list[str]:
+    """Read XFADE_TRANSITIONS from edl_render.py without importing it."""
+    tree = ast.parse(path.read_text(encoding="utf-8"))
+    for node in tree.body:
+        if not isinstance(node, ast.Assign):
+            continue
+        for target in node.targets:
+            if isinstance(target, ast.Name) and target.id == "XFADE_TRANSITIONS":
+                value = ast.literal_eval(node.value)
+                if not isinstance(value, tuple):
+                    raise SystemExit(f"{path}: XFADE_TRANSITIONS is not a tuple")
+                return list(value)
+    raise SystemExit(f"{path}: XFADE_TRANSITIONS not found")
+
+
+def family_of(name: str) -> str:
+    for family, names in FAMILIES.items():
+        if name in names:
+            return family
+    return "other"
+
+
+def _filter_path(path: Path) -> str:
+    """Escape an absolute path for use inside an ffmpeg filter option."""
+    return str(path).replace("\\", "/").replace(":", r"\:").replace("'", r"\'")
+
+
+def find_font() -> Path | None:
+    windir = Path(os.environ.get("WINDIR", "C:/Windows"))
+    candidates = [
+        windir / "Fonts" / "arialbd.ttf",
+        windir / "Fonts" / "segoeuib.ttf",
+        Path("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"),
+        Path("/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf"),
+        Path("/Library/Fonts/Arial Bold.ttf"),
+        Path("/System/Library/Fonts/Supplemental/Arial Bold.ttf"),
+    ]
+    for candidate in candidates:
+        if candidate.is_file():
+            return candidate
+    return None
+
+
+def _drawtext_options(font: Path | None) -> str:
+    if font is None:
+        return ""
+    return f"fontfile='{_filter_path(font)}':"
+
+
+def _card_chain(index: int, name: str, label: str, font: Path | None) -> str:
+    if index == 0:
+        background = "0x1E3A8A"  # deep blue
+        letter = "A"
+        letter_colour = "0xFFD166"  # warm yellow
+        box = "x=60:y=60:w=360:h=220"
+    else:
+        background = "0xD97706"  # burnt orange
+        letter = "B"
+        letter_colour = "0x64F4D2"  # mint
+        box = "x=660:y=1640:w=360:h=220"
+    font_arg = _drawtext_options(font)
+    return (
+        f"[{index}:v]"
+        f"drawbox={box}:color=white@0.9:t=fill,"
+        f"drawtext={font_arg}text='{letter}':fontcolor={letter_colour}"
+        ":fontsize=260:x=(w-text_w)/2:y=720,"
+        f"drawtext={font_arg}text='{name}':fontcolor=white"
+        ":fontsize=64:x=(w-text_w)/2:y=1480,"
+        f"drawtext={font_arg}text='{label}':fontcolor=white@0.75"
+        ":fontsize=40:x=(w-text_w)/2:y=1560,"
+        "setsar=1,settb=AVTB,format=yuv420p"
+    )
+
+
+def render_transition(name: str, output: Path, font: Path | None) -> dict:
+    """Render one two-shot xfade join and probe it."""
+    graph = (
+        _card_chain(0, name, "A -> B", font) + "[a];"
+        + _card_chain(1, name, "B side", font) + "[b];"
+        f"[a][b]xfade=transition={name}:duration={TRANSITION_SECONDS}"
+        f":offset={OFFSET_SECONDS}[v]"
+    )
+    command = [
+        "ffmpeg", "-y", "-hide_banner", "-loglevel", "error",
+        "-f", "lavfi", "-i",
+        f"color=c=0x1E3A8A:s={WIDTH}x{HEIGHT}:r={FPS}:d={CARD_SECONDS}",
+        "-f", "lavfi", "-i",
+        f"color=c=0xD97706:s={WIDTH}x{HEIGHT}:r={FPS}:d={CARD_SECONDS}",
+        "-filter_complex", graph,
+        "-map", "[v]",
+        "-c:v", "libx264", "-preset", "veryfast", "-crf", "23",
+        "-pix_fmt", "yuv420p", "-movflags", "+faststart",
+        str(output),
+    ]
+    rendered = subprocess.run(command, capture_output=True, text=True)
+    if rendered.returncode != 0:
+        return {
+            "name": name,
+            "rendered": False,
+            "error": (rendered.stderr or "").strip().splitlines()[-1:] or [
+                f"ffmpeg exited {rendered.returncode}"
+            ],
+        }
+    probe = subprocess.run(
+        [
+            "ffprobe", "-v", "error",
+            "-show_entries", "stream=codec_type,codec_name,width,height,nb_frames",
+            "-show_entries", "format=duration",
+            "-of", "json", str(output),
+        ],
+        capture_output=True, text=True,
+    )
+    if probe.returncode != 0:
+        return {
+            "name": name,
+            "rendered": False,
+            "error": (probe.stderr or "").strip().splitlines()[-1:],
+        }
+    payload = json.loads(probe.stdout or "{}")
+    video = next(
+        (s for s in payload.get("streams", []) if s.get("codec_type") == "video"),
+        None,
+    )
+    duration = float((payload.get("format") or {}).get("duration") or 0.0)
+    geometry_ok = (
+        video is not None
+        and int(video.get("width") or 0) == WIDTH
+        and int(video.get("height") or 0) == HEIGHT
+    )
+    duration_ok = abs(duration - EXPECTED_DURATION) <= 0.1
+    return {
+        "name": name,
+        "rendered": geometry_ok and duration_ok,
+        "duration": duration,
+        "width": int((video or {}).get("width") or 0),
+        "height": int((video or {}).get("height") or 0),
+        "frames": (video or {}).get("nb_frames"),
+        "error": None
+        if geometry_ok and duration_ok
+        else f"bad probe output: {json.dumps(payload)[:400]}",
+    }
+
+
+def _raw_frame_signature(clip: Path, frame: int, size: int) -> bytes:
+    result = subprocess.run(
+        [
+            "ffmpeg", "-v", "error", "-i", str(clip),
+            "-vf",
+            f"select='eq(n\\,{frame})',scale={size}:{size}:flags=area,format=gray",
+            "-fps_mode", "passthrough", "-frames:v", "1",
+            "-f", "rawvideo", "-",
+        ],
+        capture_output=True,
+    )
+    if result.returncode != 0 or len(result.stdout) != size * size:
+        detail = (result.stderr or b"").decode("utf-8", "replace").strip()
+        raise RuntimeError(f"could not read frame {frame}: {detail[-300:]}")
+    return result.stdout
+
+
+def _sequence_signature(clip: Path) -> bytes:
+    frames = "+".join(f"eq(n\\,{frame})" for frame in SEQUENCE_FRAMES)
+    result = subprocess.run(
+        [
+            "ffmpeg", "-v", "error", "-i", str(clip),
+            "-vf",
+            f"select='{frames}',"
+            f"scale={SEQUENCE_SIGNATURE_SIZE}:{SEQUENCE_SIGNATURE_SIZE}:"
+            "flags=area,format=gray",
+            "-fps_mode", "passthrough", "-f", "rawvideo", "-",
+        ],
+        capture_output=True,
+    )
+    expected = SEQUENCE_SIGNATURE_SIZE * SEQUENCE_SIGNATURE_SIZE * len(SEQUENCE_FRAMES)
+    if result.returncode != 0 or len(result.stdout) != expected:
+        detail = (result.stderr or b"").decode("utf-8", "replace").strip()
+        raise RuntimeError(f"could not read sequence frames: {detail[-300:]}")
+    return result.stdout
+
+
+def extract_midpoint_png(clip: Path, destination: Path) -> None:
+    result = subprocess.run(
+        [
+            "ffmpeg", "-y", "-v", "error", "-i", str(clip),
+            "-vf", f"select='eq(n\\,{MIDPOINT_FRAME})'",
+            "-frames:v", "1", str(destination),
+        ],
+        capture_output=True,
+        text=True,
+    )
+    if result.returncode != 0 or not destination.is_file():
+        raise RuntimeError(
+            (result.stderr or "").strip()[-300:] or "midpoint frame was not written"
+        )
+
+
+def mean_abs_distance(first: bytes, second: bytes) -> float:
+    """Mean absolute difference of two grey signatures, 0..255."""
+    if len(first) != len(second) or not first:
+        return float("inf")
+    return sum(abs(a - b) for a, b in zip(first, second)) / len(first)
+
+
+def group_near_identical(
+    names: list[str], signatures: dict[str, bytes], threshold: float
+) -> list[list[str]]:
+    """Connected groups whose pairwise signature distance is below threshold."""
+    parent = {name: name for name in names}
+
+    def find(name: str) -> str:
+        while parent[name] != name:
+            parent[name] = parent[parent[name]]
+            name = parent[name]
+        return name
+
+    def union(first: str, second: str) -> None:
+        root_a, root_b = find(first), find(second)
+        if root_a != root_b:
+            parent[root_b] = root_a
+
+    for index, first in enumerate(names):
+        for second in names[index + 1:]:
+            if mean_abs_distance(signatures[first], signatures[second]) < threshold:
+                union(first, second)
+    groups: dict[str, list[str]] = {}
+    for name in names:
+        groups.setdefault(find(name), []).append(name)
+    return list(groups.values())
+
+
+def contact_sheet(
+    family: str, names: list[str], frames: dict[str, Path], output: Path
+) -> Path | None:
+    available = [name for name in names if name in frames]
+    if not available:
+        return None
+    columns = min(4, len(available))
+    rows = math.ceil(len(available) / columns)
+    with tempfile.TemporaryDirectory(prefix="transition-sheet-") as tmp:
+        tmp_dir = Path(tmp)
+        for index, name in enumerate(available, start=1):
+            shutil.copyfile(frames[name], tmp_dir / f"{index:04d}.png")
+        command = [
+            "ffmpeg", "-y", "-v", "error",
+            "-framerate", "1", "-start_number", "1",
+            "-i", str(tmp_dir / "%04d.png"),
+            "-vf",
+            f"scale=180:320:flags=lanczos,"
+            f"tile={columns}x{rows}:padding=6:margin=6:color=0x222222",
+            "-frames:v", "1", str(output),
+        ]
+        result = subprocess.run(command, capture_output=True, text=True)
+        if result.returncode != 0 or not output.is_file():
+            print(
+                f"contact sheet {family} failed: {(result.stderr or '').strip()}",
+                file=sys.stderr,
+            )
+            return None
+    return output
+
+
+def format_groups(groups: list[list[str]], names: list[str]) -> dict[str, list[str]]:
+    """Map each name to the other names in its near-identical group."""
+    near: dict[str, list[str]] = {}
+    for group in groups:
+        if len(group) < 2:
+            continue
+        for name in group:
+            near[name] = [other for other in group if other != name]
+    return near
+
+
+def write_table(
+    output: Path,
+    transitions: list[str],
+    results: dict[str, dict],
+    midpoint_near: dict[str, list[str]],
+    sequence_near: dict[str, list[str]],
+    midpoint_distances: dict[tuple[str, str], float],
+) -> None:
+    lines = [
+        "| Transition | Family | Rendered OK | Duration (s) | Distinct-from |",
+        "| --- | --- | --- | --- | --- |",
+    ]
+    for name in transitions:
+        result = results[name]
+        family = family_of(name)
+        if not result["rendered"]:
+            lines.append(f"| {name} | {family} | FAILED | - | {result.get('error')} |")
+            continue
+        near = midpoint_near.get(name, [])
+        if near:
+            detail = []
+            for other in near:
+                key = tuple(sorted((name, other)))
+                distance = midpoint_distances.get(key)
+                detail.append(
+                    f"{other} (delta {distance:.2f})" if distance is not None else other
+                )
+            distinct = ", ".join(detail)
+        else:
+            distinct = "-"
+        lines.append(
+            f"| {name} | {family} | OK | {result['duration']:.3f} | {distinct} |"
+        )
+    lines.append("")
+    lines.append(
+        "`Distinct-from` lists other variants whose midpoint signature is "
+        "within "
+        f"{MIDPOINT_NEAR_IDENTICAL:.2f} (mean absolute grey difference); "
+        "those are visually the same at the transition's halfway point."
+    )
+    lines.append(
+        "`Sequence near-identical` below uses three frames (25/50/75% of "
+        "the transition), so timing-only variants such as fade/fadefast/"
+        "fadeslow are separated there."
+    )
+    lines.append("")
+    lines.append("### Sequence near-identical groups")
+    lines.append("")
+    sequence_groups = sorted(set(tuple(sorted(group)) for group in sequence_near.values()))
+    if not sequence_groups:
+        lines.append("None.")
+    else:
+        for group in sorted(sequence_groups):
+            lines.append(f"- {', '.join(group)}")
+    output.write_text("\n".join(lines) + "\n", encoding="utf-8")
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--out",
+        type=Path,
+        default=Path(__file__).resolve().parent / "out",
+        help="output directory (default: tools/transitions-proof/out)",
+    )
+    parser.add_argument(
+        "--only",
+        default=None,
+        help="comma-separated transition names to render (default: all)",
+    )
+    parser.add_argument(
+        "--threshold",
+        type=float,
+        default=MIDPOINT_NEAR_IDENTICAL,
+        help="midpoint near-identical threshold (mean absolute difference)",
+    )
+    args = parser.parse_args(argv)
+
+    transitions = load_transitions(EDL_RENDER)
+    if args.only:
+        requested = [name.strip() for name in args.only.split(",") if name.strip()]
+        unknown = sorted(set(requested) - set(transitions))
+        if unknown:
+            parser.error(f"unknown transitions: {', '.join(unknown)}")
+        transitions = [name for name in transitions if name in requested]
+
+    font = find_font()
+    out_dir = args.out.resolve()
+    clips_dir = out_dir / "clips"
+    frames_dir = out_dir / "frames"
+    clips_dir.mkdir(parents=True, exist_ok=True)
+    frames_dir.mkdir(parents=True, exist_ok=True)
+
+    results: dict[str, dict] = {}
+    midpoint_signatures: dict[str, bytes] = {}
+    sequence_signatures: dict[str, bytes] = {}
+    frames: dict[str, Path] = {}
+
+    print(f"Rendering {len(transitions)} transitions at {WIDTH}x{HEIGHT}, "
+          f"{TRANSITION_SECONDS}s xfade ...")
+    for index, name in enumerate(transitions, start=1):
+        clip = clips_dir / f"{name}.mp4"
+        result = render_transition(name, clip, font)
+        if result["rendered"]:
+            try:
+                extract_midpoint_png(clip, frames_dir / f"{name}.png")
+                midpoint_signatures[name] = _raw_frame_signature(
+                    clip, MIDPOINT_FRAME, SIGNATURE_SIZE
+                )
+                sequence_signatures[name] = _sequence_signature(clip)
+                frames[name] = frames_dir / f"{name}.png"
+            except RuntimeError as exc:
+                result["rendered"] = False
+                result["error"] = str(exc)
+        results[name] = result
+        status = "OK" if result["rendered"] else "FAILED"
+        duration = (
+            f"{result['duration']:.3f}s" if result.get("duration") is not None else "-"
+        )
+        print(f"  [{index:02d}/{len(transitions)}] {name:14s} {status} {duration}")
+
+    working = [name for name in transitions if results[name]["rendered"]]
+    midpoint_groups = group_near_identical(
+        working, midpoint_signatures, args.threshold
+    )
+    sequence_groups = group_near_identical(
+        working, sequence_signatures, SEQUENCE_NEAR_IDENTICAL
+    )
+    midpoint_near = format_groups(midpoint_groups, transitions)
+    sequence_near = format_groups(sequence_groups, transitions)
+
+    midpoint_distances: dict[tuple[str, str], float] = {}
+    for index, first in enumerate(working):
+        for second in working[index + 1:]:
+            midpoint_distances[tuple(sorted((first, second)))] = mean_abs_distance(
+                midpoint_signatures[first], midpoint_signatures[second]
+            )
+
+    sheets = []
+    for family, family_names in FAMILIES.items():
+        sheet = contact_sheet(
+            family,
+            [name for name in family_names if name in transitions],
+            frames,
+            out_dir / f"contact-{family}.png",
+        )
+        if sheet is not None:
+            sheets.append(sheet)
+    other = [name for name in transitions if family_of(name) == "other" and name in frames]
+    if other:
+        sheet = contact_sheet("other", other, frames, out_dir / "contact-other.png")
+        if sheet is not None:
+            sheets.append(sheet)
+
+    signatures_payload = {
+        "width": WIDTH,
+        "height": HEIGHT,
+        "fps": FPS,
+        "card_seconds": CARD_SECONDS,
+        "transition_seconds": TRANSITION_SECONDS,
+        "midpoint_frame": MIDPOINT_FRAME,
+        "sequence_frames": list(SEQUENCE_FRAMES),
+        "midpoint_signature_size": SIGNATURE_SIZE,
+        "sequence_signature_size": SEQUENCE_SIGNATURE_SIZE,
+        "midpoint_threshold": args.threshold,
+        "sequence_threshold": SEQUENCE_NEAR_IDENTICAL,
+        "rendered_ok": working,
+        "failed": {
+            name: results[name].get("error")
+            for name in transitions
+            if not results[name]["rendered"]
+        },
+        "midpoint_near_identical_groups": [
+            group for group in midpoint_groups if len(group) > 1
+        ],
+        "sequence_near_identical_groups": [
+            group for group in sequence_groups if len(group) > 1
+        ],
+        "signatures": {
+            name: {
+                "midpoint": base64.b64encode(midpoint_signatures[name]).decode("ascii"),
+                "sequence": base64.b64encode(sequence_signatures[name]).decode("ascii"),
+            }
+            for name in working
+        },
+    }
+    (out_dir / "signatures.json").write_text(
+        json.dumps(signatures_payload, indent=2), encoding="utf-8"
+    )
+    write_table(
+        out_dir / "table.md",
+        transitions,
+        results,
+        midpoint_near,
+        sequence_near,
+        midpoint_distances,
+    )
+
+    midpoint_distinct = len([g for g in midpoint_groups if len(g) > 1])
+    sequence_variant_groups = [g for g in sequence_groups if len(g) > 1]
+    sequence_distinct = len(working) - sum(
+        len(group) - 1 for group in sequence_variant_groups
+    )
+    print()
+    print(f"Rendered OK:            {len(working)}/{len(transitions)}")
+    print(f"Midpoint clusters:      {midpoint_distinct} near-identical group(s) "
+          f"among {len(working)} working variants")
+    print(f"Distinct variants:      {sequence_distinct} of {len(working)} working, "
+          "by three-frame signature")
+    if not working:
+        print("No transition rendered; nothing to compare.")
+    print(f"Table:                  {out_dir / 'table.md'}")
+    print(f"Signatures:             {out_dir / 'signatures.json'}")
+    if sheets:
+        print("Contact sheets:")
+        for sheet in sheets:
+            print(f"  {sheet}")
+    print()
+    print(
+        "Honest note: the distinct-variant count is signature-based (32x32 "
+        "grey midpoint plus a three-frame 32x32 check). It measures what the "
+        "transition looks like, not how it moves; inspect the contact sheets "
+        "and clips before treating a variant as useful."
+    )
+    return 0 if len(working) == len(transitions) else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
