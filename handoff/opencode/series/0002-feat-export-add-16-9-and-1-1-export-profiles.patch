+def _fit_on_black_filter(width: int, height: int) -> str:
+    return (
+        f"scale={width}:{height}:"
+        "force_original_aspect_ratio=decrease:flags=lanczos,"
+        f"pad={width}:{height}:(ow-iw)/2:(oh-ih)/2,"
+        "setsar=1"
+    )
+
+
+def _fit_on_blur_filter(width: int, height: int) -> str:
+    """Fit the whole picture, fill the bands with a blurred enlargement.
+
+    The foreground is only ever scaled down to fit (never up-and-cropped),
+    so the complete 9:16 picture -- captions included -- stays inside the
+    wide or square frame. The background is a separate, cropped copy of
+    the same frame, blurred, so it cannot be mistaken for content.
+    """
+    return (
+        "split=2[bg][fg];"
+        f"[bg]scale={width}:{height}:force_original_aspect_ratio=increase:"
+        "flags=lanczos,"
+        f"crop={width}:{height},boxblur=20:2[blurred];"
+        f"[fg]scale={width}:{height}:force_original_aspect_ratio=decrease:"
+        "flags=lanczos[fit];"
+        "[blurred][fit]overlay=(W-w)/2:(H-h)/2,setsar=1[outv]"
+    )
+
 # YouTube's table splits standard (24/25/30) from high (48/50/60) frame
 # rates; anything above 30 uses the high row.
 HIGH_FPS_THRESHOLD = 30.0
