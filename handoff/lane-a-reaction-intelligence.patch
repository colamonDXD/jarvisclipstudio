@@ -0,0 +1,56 @@
+"""Provider audit helpers: pure logic only, no network, no keys."""
+import importlib.util
+from pathlib import Path
+
+_spec = importlib.util.spec_from_file_location(
+    "audit_providers", Path(__file__).resolve().parents[3] / "tools" / "provider-audit" / "audit_providers.py")
+audit = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(audit)
+
+
+def test_classify_statuses():
+    c = audit.classify
+    assert (c(200), c(401), c(402), c(429), c(404), c(503), c(0)) == (
+        "OK", "AUTH_FAILED", "OUT_OF_CREDIT", "RATE_LIMITED_OR_QUOTA", "NOT_FOUND", "PROVIDER_ERROR", "UNREACHABLE")
+
+
+def test_placeholder_keys_count_as_missing():
+    env = {"GROQ_API_KEY": "changeme", "NVIDIA_API_KEY": "nvapi-realish", "X": ""}
+    assert not audit.present(env, "GROQ_API_KEY") and audit.present(env, "NVIDIA_API_KEY") and not audit.present(env, "X")
+
+
+def test_gateway_config_parses_ladder_and_static_audit_has_no_failures():
+    rows = audit.static_audit()
+    assert not [r for r in rows if r["status"] == "FAIL"], rows
+    entries = audit.parse_gateway_config((audit.ROOT / "litellm_config.yaml").read_text(encoding="utf-8"))
+    names = {e["name"] for e in entries}
+    assert {"deepseek-chat", "clip-assured", "local-qwen", "cloudflare-free"} <= names
+    assert all(not e["model"].startswith("openrouter/") or e["model"].endswith(":free") for e in entries)
+
+
+def test_report_never_contains_key_values(tmp_path, monkeypatch):
+    secret = "sk-SUPERSECRET-1234567890"
+    monkeypatch.setattr(audit, "http", lambda *a, **k: (401, "bad", {}, 0.01))
+    rows = audit.live_audit({"GROQ_API_KEY": secret, "DEEPSEEK_API_KEY": secret}, False, False)
+    assert secret not in str(rows)
+    assert [r for r in rows if r["provider"] == "groq"][0]["verdict"] == "AUTH_FAILED"
+
+
+def test_nvidia_probe_reports_working_and_missing_models(monkeypatch):
+    calls = []
+
+    def fake_http(url, key=None, body=None, **kw):
+        if url.endswith("/models"):
+            return 200, '{"data":[{"id":"nvidia/nemotron-3-ultra-550b-a55b"}]}', {}, 0.01
+        calls.append(body["model"])
+        if body["model"] == "nvidia/nemotron-3-ultra-550b-a55b":
+            return 200, '{"choices":[{"message":{"content":"ok"}}]}', {}, 0.2
+        return 404, "not found", {}, 0.1
+
+    monkeypatch.setattr(audit, "http", fake_http)
+    out = audit.probe_nvidia({"NVIDIA_API_KEY": "nvapi-SECRET-123"})
+    by = {r["model"]: r["result"] for r in out["probes"]}
+    assert by["nvidia/nemotron-3-ultra-550b-a55b"] == "WORKS"
+    assert by["deepseek-ai/deepseek-v4.1-flash"] == "NOT_FOUND"
+    assert "nvapi-SECRET-123" not in str(out)
+    assert audit.probe_nvidia({}) == {"verdict": "KEY_MISSING"}
diff --git a/backend/tests/unit/test_reaction_hooks_and_recs.py b/backend/tests/unit/test_reaction_hooks_and_recs.py
new file mode 100644
index 0000000..da400a4
--- /dev/null
+++ b/backend/tests/unit/test_reaction_hooks_and_recs.py
@@ -0,0 +1,116 @@
+"""GA2 hooks/boundaries/captions and editing recommendations for reaction clips."""
+from src.auto_director import edit_recommendations as er
+from src.auto_director import reaction_hooks as rh
+
+
+def _moment(mtype="reaction_to_event", kind="laughter", game="screen_flash_banner", r=(40.0, 46.0), g=(36.0, 39.0)):
+    return {"start_time": "00:32", "end_time": "00:50", "evidence": {
+        "moment_type": mtype, "reaction_kind": kind,
+        "reaction_start_sec": r[0], "reaction_end_sec": r[1],
+        "game_event": None if game is None else {"start_sec": g[0], "end_sec": g[1], "type": game}}}
+
+
+def test_event_hook_is_grounded_third_person_and_short():
+    t = rh.reaction_hook_title(_moment())
+    assert 3 <= len(t.split()) <= 9 and t.startswith("Streamer")
+    assert "on-screen" in t and " I " not in f" {t} "
+
+
+def test_hook_never_names_game_events_the_pictures_did_not_show():
+    for game in ("screen_flash_banner", "hud_event_streak", "erratic_motion", "visual_change", None):
+        t = rh.reaction_hook_title(_moment(game=game, mtype="reaction_to_event" if game else "commentary_reaction"))
+        assert not any(w in t.lower() for w in ("gta", "car", "explod", "kill", "crash", "police", "heist"))
+
+
+def test_commentary_has_no_invented_trigger():
+    t = rh.reaction_hook_title(_moment(mtype="commentary_reaction", game=None))
+    assert "on-screen" not in t
+
+
+def test_hooks_vary_across_clips():
+    titles = set()
+    for i in range(12):
+        m = _moment(); m["start_time"] = f"0{i % 10}:{i:02d}"
+        titles.add(rh.reaction_hook_title(m))
+    assert len(titles) >= 2
+
+
+def test_plain_gameplay_moment_gets_no_reaction_hook():
+    assert rh.reaction_hook_title({"evidence": {"detector": "frame_evidence_v1"}}) is None
+
+
+def test_profanity_modes_and_verbatim_quote():
+    words = [{"text": "oh", "start": 40.0, "end": 40.2}, {"text": "shit", "start": 40.3, "end": 40.6}]
+    assert rh.reaction_quote(words, 40, 46, "keep") == "oh shit"
+    assert rh.reaction_quote(words, 40, 46, "mask") == "oh s***"
+    assert rh.reaction_quote(words, 40, 46, "drop") == "oh"
+    assert rh.reaction_quote([], 40, 46) is None
+
+
+def test_boundaries_never_cut_a_word_and_keep_the_payoff():
+    words = [{"text": "wait", "start": 31.5, "end": 32.4}, {"text": "what", "start": 32.5, "end": 33.0},
+             {"text": "haha", "start": 45.6, "end": 46.9}]
+    s, e, notes = rh.refine_window(32.0, 46.3, 40.0, 46.0, 120.0, words)
+    assert s == 31.5 and e >= 46.9 and notes
+
+
+def test_boundaries_extend_while_reaction_still_active():
+    strength = [0.0] * 120
+    for t in range(44, 51):
+        strength[t] = 5.0
+    s, e, notes = rh.refine_window(32.0, 48.0, 44.0, 47.0, 120.0, None, strength)
+    assert e >= 50 + 1.5 and any("extended" in n for n in notes)
+
+
+def test_caption_plan_puts_emphasis_on_reaction_and_event_cue_on_event():
+    words = [{"text": "no", "start": 40.1, "end": 40.3}]
+    plan = rh.caption_plan(_moment(), 32.0, words, (0.7, 0.6, 0.25, 0.3), "keep")
+    assert plan["emphasis"][0]["start"] == 8.0 and plan["emphasis"][0]["style"] == "laugh"
+    assert plan["event_cue"]["at"] == 4.0 and plan["event_cue"]["not_audio_peak"] is True
+    # Reaction-led clip with a facecam -> stacked reactor layout -> captions on the pane seam.
+    assert plan["position"]["anchor"] == "pane_seam" and "facecam" in plan["position"]["avoid"]
+    assert plan["emphasis_words"][0]["text"] == "no"
+
+
+def test_recommendations_contract_and_bounds():
+    m = _moment()
+    rec = er.recommend_edits(m, 32.0, 50.0, facecam_roi=(0.7, 0.6, 0.25, 0.3))
+    assert rec["schema_version"] == 1
+    assert rec["framing"]["layout"] == "stacked_reactor" and rec["framing"]["facecam_roi"]
+    assert all(z["to_scale"] <= 1.15 and z["start"] >= 0 and z["end"] <= 18.0 for z in rec["zooms"])
+    assert rec["pacing"]["open_on"] == "trigger" and rec["sfx_cues"][0]["requires_library"] is True
+
+
+def test_no_facecam_means_fit_game_only():
+    rec = er.recommend_edits(_moment(), 32.0, 50.0, facecam_roi=None)
+    assert rec["framing"]["layout"] == "full" and rec["framing"]["mode"] == "fit"
+    assert all(z["target"] == "gameplay" for z in rec["zooms"])
+
+
+def test_no_trigger_opens_on_reaction():
+    rec = er.recommend_edits(_moment(mtype="commentary_reaction", game=None), 32.0, 50.0)
+    assert rec["pacing"]["open_on"] == "reaction" and rec["sfx_cues"] == []
+
+
+def test_quote_rejects_fragments_and_centres_on_the_exclamation():
+    assert rh.reaction_quote([{"text": "Come", "start": 40.0, "end": 40.2}], 40, 46) is None
+    words = [{"text": t, "start": 40.0 + i * 0.3, "end": 40.2 + i * 0.3} for i, t in
+             enumerate(["so", "I", "was", "going", "there", "and", "what", "the", "hell!", "bro"])]
+    q = rh.reaction_quote(words, 40, 46, "keep")
+    assert "hell!" in q and len(q.split()) <= 6
+
+
+def test_layout_and_caption_vocabulary_match_the_app_and_the_amendment():
+    from src.auto_director.clip_edits import CAPTION_POSITIONS
+
+    layouts = {er.recommend_framing(roi, mt, "shout")["layout"]
+               for roi in (None, (0.7, 0.6, 0.25, 0.3)) for mt in ("reaction_to_event", "silent_action")}
+    assert layouts <= {"stacked_reactor", "pip_preserved", "full"}
+    for roi, layout in ((None, "full"), ((0.7, 0.6, 0.25, 0.3), "stacked_reactor"),
+                        ((0.7, 0.6, 0.25, 0.3), "pip_preserved"), ((0.05, 0.05, 0.2, 0.3), "pip_preserved")):
+        pos = rh.caption_position(roi, layout)
+        assert pos["preset"] in CAPTION_POSITIONS
+    assert rh.caption_position((0.7, 0.6, 0.25, 0.3), "pip_preserved")["preset"] == "top"
+    assert rh.caption_position((0.05, 0.05, 0.2, 0.3), "pip_preserved")["preset"] == "bottom"
+    rec = er.recommend_edits(_moment(), 32.0, 50.0, facecam_roi=(0.7, 0.6, 0.25, 0.3))
+    assert {z["target"] for z in rec["zooms"]} <= {"facecam", "gameplay"}
diff --git a/backend/tests/unit/test_reaction_moments.py b/backend/tests/unit/test_reaction_moments.py
new file mode 100644
index 0000000..abc935a
--- /dev/null
+++ b/backend/tests/unit/test_reaction_moments.py
@@ -0,0 +1,149 @@
+"""Streamer-reaction fusion: voice/face agreement, event correlation, no loud-audio fakes."""
+import numpy as np
+
+from src.auto_director import gameplay_moments as gm
+from src.auto_director import reaction_moments as rm
+
+
+def _voice(seconds=120):
+    rng = np.random.default_rng(3)
+    return {
+        "vocal": 30 + rng.normal(0, 0.5, seconds),
+        "f0": 125 + rng.normal(0, 3, seconds),
+        "voiced_frac": np.full(seconds, 0.35),
+        "laugh": np.abs(rng.normal(0.1, 0.02, seconds)),
+        "total_db": np.full(seconds, 40.0),
+    }
+
+
+def _face(seconds=120):
+    return 1.0 + np.abs(np.random.default_rng(4).normal(0, 0.05, seconds))
+
+
+def _game(seconds=120, events=()):
+    rng = np.random.default_rng(5)
+    base = {"motion": 0.4, "local": 0.5, "tint": 1.5, "shake": 0.05,
+            "text": 0.0, "novelty": 1.0, "pursuit": 0.5}
+    ev = {f: base[f] + rng.normal(0, 0.02 * max(base[f], 0.2), seconds) for f in gm.FEATURES}
+    for a, b in events:
+        for s in range(a, b):
+            ev["tint"][s] += 12
+            ev["local"][s] += 6
+    ev["duration"] = np.array([float(seconds)])
+    return ev
+
+
+def _pick(voice, face, game):
+    return rm.select_streamer_moments("x.mp4", 120.0, target_count=5, clip_seconds=30,
+                                      voice=voice, face=face, game_evidence=game)
+
+
+def test_calm_streamer_over_ordinary_gameplay_yields_nothing():
+    assert _pick(_voice(), _face(), _game()) == []
+
+
+def test_loud_game_audio_without_voice_is_not_a_reaction():
+    v = _voice()
+    v["total_db"][50:53] = 80.0           # explosion: loud, but not voiced
+    assert _pick(v, _face(), _game()) == []
+
+
+def test_unreacted_game_event_is_not_selected_when_a_real_reaction_exists():
+    v = _voice(); f = _face()
+    v["vocal"][90:94] += 15; v["f0"][90:94] += 120   # a shout at 90 s
+    f[90:94] += 12
+    out = _pick(v, f, _game(events=[(30, 36), (88, 91)]))
+    types = [m["hook_type"] for m in out]
+    assert types == ["reaction_to_event"]
+    assert "00:30" not in out[0]["start_time"]
+
+
+def test_reaction_to_event_outranks_commentary_and_keeps_trigger_in_window():
+    v = _voice(); f = _face()
+    for a in (40, 90):                                   # same shout twice
+        v["vocal"][a:a + 4] += 15; v["f0"][a:a + 4] += 120; f[a:a + 4] += 12
+    out = _pick(v, f, _game(events=[(37, 40)]))          # only the first has a trigger
+    by_type = {m["hook_type"]: m for m in out}
+    assert by_type["reaction_to_event"]["virality_score"] >= by_type["commentary_reaction"]["virality_score"]
+    m = by_type["reaction_to_event"]
+    assert m["start_time"] <= "00:37" and m["end_time"] > "00:44"
+    assert m["evidence"]["game_event"] is not None
+
+
+def test_silent_facecam_alone_is_weak_and_dropped():
+    f = _face(); f[60:64] += 12
+    out = _pick(_voice(), f, _game(events=[(58, 62)]))
+    # Only the low-scored "game event the streamer ignored" fallback may remain;
+    # visual_moments drops it, so it never becomes a pick on its own.
+    assert [m["hook_type"] for m in out] in ([], ["silent_action"])
+    assert all(m["virality_score"] <= 40 for m in out)
+
+
+def test_no_voice_no_face_returns_empty_for_fallback():
+    assert rm.select_streamer_moments("x.mp4", 60.0, target_count=3, clip_seconds=30,
+                                      voice={}, face=None, game_evidence=_game(60)) == []
+
+
+def test_hints_text_format(monkeypatch):
+    v = _voice(); f = _face()
+    v["vocal"][90:94] += 15; v["f0"][90:94] += 120; f[90:94] += 12
+    monkeypatch.setattr(rm, "extract_voice_evidence", lambda p: v)
+    monkeypatch.setattr(rm, "find_facecam", lambda p, d: (0.7, 0.6, 0.25, 0.3))
+    monkeypatch.setattr(rm, "extract_facecam_activity", lambda p, r: f)
+    monkeypatch.setattr(rm, "extract_frame_evidence", lambda p, mask_roi=None: _game(events=[(88, 91)]))
+    text = rm.build_reaction_hints("x.mp4", 120.0)
+    assert text.startswith("Measured streamer-reaction signals") and "reaction to event" in text
+
+
+def test_single_modality_is_capped_below_corroborated_moments():
+    v = _voice()
+    v["vocal"][90:94] += 15; v["f0"][90:94] += 120          # voice only: no face, no event
+    solo = _pick(v, None, _game())
+    assert solo and solo[0]["virality_score"] <= 55 and solo[0]["evidence"]["modalities"] == ["voice"]
+    f = _face(); f[90:94] += 12
+    backed = _pick(v, f, _game(events=[(88, 91)]))
+    assert backed[0]["virality_score"] > solo[0]["virality_score"]
+    assert set(backed[0]["evidence"]["modalities"]) == {"voice", "face", "context"}
+
+
+def test_voice_source_mouth_rule():
+    still = np.full(14, 0.01)
+    assert rm.voice_is_streamers(still, (6, 10)) is False          # voice rose, mouth did not move
+    moving = still.copy(); moving[6:10] = 0.05
+    assert rm.voice_is_streamers(moving, (6, 10)) is True
+    assert rm.voice_is_streamers(None, (6, 10)) is None             # no face: unknown, fail open
+    assert rm.voice_is_streamers(np.full(14, np.nan), (6, 10)) is None
+
+
+def test_game_audio_voice_is_demoted(monkeypatch, tmp_path):
+    video = tmp_path / "v.mp4"; video.write_bytes(b"x")
+    item = {"type": "commentary_reaction", "start": 40.0, "end": 44.0, "mult": 1.0,
+            "features": {"vocal": 8.0, "pitch": 5.0, "laugh": 0.0, "face": 0.5}}
+    monkeypatch.setattr(rm, "mouth_motion", lambda *a, **k: np.full(14, 0.01))
+    rm.check_voice_source([item], video, (0.1, 0.1, 0.2, 0.3))
+    assert item["voice_source"].startswith("likely game audio") and item["mult"] == 0.5
+    assert item["features"]["vocal"] == 0.0 and "voice" not in rm.modalities(item)
+
+
+def test_lexical_series_counts_reaction_words_and_repeats():
+    words = [{"text": "No,", "start": 10.1}, {"text": "no,", "start": 10.4}, {"text": "no!", "start": 10.7},
+             {"text": "the", "start": 20.0}, {"text": "que", "start": 30.0}, {"text": "¿Qué?", "start": 31.0}]
+    lex = rm.lexical_series(words, 40)
+    assert lex[10] >= 3.5 and lex[20] == 0 and lex[30] == 0 and lex[31] >= 1
+
+
+def test_words_in_milliseconds_are_converted():
+    w = rm._words_in_seconds([{"text": "yo", "start": 12000, "end": 12300}], 60.0)
+    assert w[0]["start"] == 12.0
+
+
+def test_reaction_words_alone_never_make_a_moment_but_corroborate_one():
+    words = [{"text": t, "start": 90.0 + i * 0.3, "end": 90.2 + i * 0.3} for i, t in enumerate(["no", "no", "no", "what!"])]
+    assert _pick(_voice(), _face(), _game()) == []
+    alone = rm.select_streamer_moments("x.mp4", 120.0, target_count=3, clip_seconds=30, voice=_voice(),
+                                       face=_face(), game_evidence=_game(), words=words)
+    assert [m for m in alone if m["hook_type"] != "silent_action"] == []
+    f = _face(); f[90:93] += 12
+    backed = rm.select_streamer_moments("x.mp4", 120.0, target_count=3, clip_seconds=30, voice=_voice(),
+                                        face=f, game_evidence=_game(), words=words)
+    assert backed and backed[0]["evidence"]["signals"].get("lexical", 0) >= 3
