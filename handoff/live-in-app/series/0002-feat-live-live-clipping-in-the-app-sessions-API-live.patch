diff --git a/backend/src/api/routes/live.py b/backend/src/api/routes/live.py
new file mode 100644
index 0000000..f4cfdcd
--- /dev/null
+++ b/backend/src/api/routes/live.py
@@ -0,0 +1,188 @@
+"""Live clipping API (``LIVE_CLIPPING``, off by default: every route 403s).
+
+- ``GET  /live/status``                   -> {"enabled": bool}; never 403, so clients can hide the feature
+- ``POST /live/sessions``                 -> start clipping a live stream (one active session per user)
+- ``GET  /live/sessions``                 -> the caller's sessions, newest first
+- ``GET  /live/sessions/{id}``            -> one session with its clips (poll every few seconds)
+- ``POST /live/sessions/{id}/stop``       -> stop recording (queued clips still finish)
+- ``DELETE /live/sessions/{id}``          -> delete a finished session and its files
+- ``GET  /live/clips/{id}/file?kind=clip|preview`` -> the MP4
+
+Body of ``POST /live/sessions``: ``{"url", "layout_template"?: "facecam_red" | "facecam_gold" | null,
+"credit"?, "hook_title"?, "niche"?, "streamer_words_only"?: bool, "max_clips"?: 1..60}``.
+The URL must be a YouTube or Twitch page that is live right now.
+"""
+from __future__ import annotations
+
+import logging
+import os
+import shutil
+import subprocess
+from pathlib import Path
+from typing import Any, Dict
+
+from fastapi import APIRouter, Depends, HTTPException, Request
+from fastapi.responses import FileResponse
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from ...auth_headers import resolve_authenticated_user_id
+from ...auto_director.niche import validate_niche_override
+from ...config import get_config
+from ...database import get_db
+from ...live import live_clipping_enabled
+from ...live.finisher import LAYOUTS
+from ...repositories.live_repository import LiveRepository
+from ...utils.async_helpers import run_in_thread
+
+logger = logging.getLogger(__name__)
+
+router = APIRouter(prefix="/live", tags=["live clipping"])
+repository = LiveRepository()
+
+LIVE_HOSTS = ("twitch.tv", "youtube.com", "youtu.be")
+
+
+def _require_enabled() -> None:
+    if not live_clipping_enabled():
+        raise HTTPException(status_code=403, detail="Live clipping is not enabled on this server")
+
+
+def live_root() -> Path:
+    return Path(os.getenv("TEMP_DIR", "/tmp")) / "live"
+
+
+def probe_live_status(url: str) -> str:
+    """yt-dlp's ``live_status`` for a page: is_live, was_live, not_live, is_upcoming, or error."""
+    try:
+        out = subprocess.run(["yt-dlp", "-q", "--no-warnings", "--skip-download", "--print", "live_status", url],
+                             capture_output=True, text=True, timeout=45)
+    except (OSError, subprocess.TimeoutExpired) as exc:
+        logger.warning("Live status probe failed: %s", exc)
+        return "error"
+    lines = [line.strip() for line in out.stdout.splitlines() if line.strip()]
+    return lines[0] if lines else "error"
+
+
+async def _json_body(request: Request) -> Dict[str, Any]:
+    try:
+        data = await request.json()
+    except Exception:
+        raise HTTPException(status_code=422, detail="Body must be JSON") from None
+    if not isinstance(data, dict):
+        raise HTTPException(status_code=422, detail="Body must be a JSON object")
+    return data
+
+
+def _text(data: Dict[str, Any], key: str, limit: int) -> Any:
+    value = data.get(key)
+    if value is None:
+        return None
+    if not isinstance(value, str):
+        raise HTTPException(status_code=422, detail=f"{key} must be text")
+    value = value.strip()
+    if len(value) > limit:
+        raise HTTPException(status_code=422, detail=f"{key} is longer than {limit} characters")
+    return value or None
+
+
+def validate_settings(data: Dict[str, Any]) -> Dict[str, Any]:
+    layout = data.get("layout_template", "facecam_red")
+    if layout is not None and layout not in LAYOUTS:
+        raise HTTPException(status_code=422, detail=f"layout_template must be one of {list(LAYOUTS)} or null")
+    try:
+        niche = validate_niche_override(data.get("niche")) or "gaming"
+    except ValueError as exc:
+        raise HTTPException(status_code=422, detail=str(exc)) from None
+    words_only = data.get("streamer_words_only", True)
+    if not isinstance(words_only, bool):
+        raise HTTPException(status_code=422, detail="streamer_words_only must be true or false")
+    max_clips = data.get("max_clips", 30)
+    if not isinstance(max_clips, int) or isinstance(max_clips, bool) or not 1 <= max_clips <= 60:
+        raise HTTPException(status_code=422, detail="max_clips must be a whole number from 1 to 60")
+    return {"layout_template": layout, "niche": niche, "streamer_words_only": words_only, "max_clips": max_clips,
+            "credit": _text(data, "credit", 40), "hook_title": _text(data, "hook_title", 80)}
+
+
+@router.get("/status")
+async def live_status():
+    return {"enabled": live_clipping_enabled()}
+
+
+@router.post("/sessions", status_code=201)
+async def start_session(request: Request, db: AsyncSession = Depends(get_db)):
+    _require_enabled()
+    user_id = await resolve_authenticated_user_id(request, db, get_config())
+    data = await _json_body(request)
+    url = _text(data, "url", 500)
+    if not url or not url.startswith(("https://", "http://")) or not any(h in url for h in LIVE_HOSTS):
+        raise HTTPException(status_code=422, detail="Paste the link of a live stream on YouTube or Twitch")
+    settings = validate_settings(data)
+    if await repository.count_active(db, user_id):
+        raise HTTPException(status_code=409, detail="You already have a live session running. Stop it first.")
+    status = await run_in_thread(probe_live_status, url)
+    if status != "is_live":
+        detail = {"is_upcoming": "This stream hasn't started yet. Start live clipping once it's live.",
+                  "was_live": "This stream has ended. Use it as a normal video instead.",
+                  "not_live": "This video isn't a live stream. Use it as a normal video instead."}.get(
+            status, "We couldn't open this stream. Check the link and that the stream is live.")
+        raise HTTPException(status_code=422, detail={"code": f"LIVE_{status.upper()}", "message": detail})
+    session = await repository.create_session(db, user_id, url, settings)
+    return {"session": session}
+
+
+@router.get("/sessions")
+async def list_sessions(request: Request, db: AsyncSession = Depends(get_db)):
+    _require_enabled()
+    user_id = await resolve_authenticated_user_id(request, db, get_config())
+    return {"sessions": await repository.list_sessions(db, user_id)}
+
+
+@router.get("/sessions/{session_id}")
+async def get_session(session_id: str, request: Request, db: AsyncSession = Depends(get_db)):
+    _require_enabled()
+    user_id = await resolve_authenticated_user_id(request, db, get_config())
+    session = await repository.get_session(db, session_id, user_id)
+    if session is None:
+        raise HTTPException(status_code=404, detail="Live session not found")
+    return {"session": session, "clips": await repository.list_clips(db, session_id)}
+
+
+@router.post("/sessions/{session_id}/stop")
+async def stop_session(session_id: str, request: Request, db: AsyncSession = Depends(get_db)):
+    _require_enabled()
+    user_id = await resolve_authenticated_user_id(request, db, get_config())
+    if not await repository.request_stop(db, session_id, user_id):
+        if await repository.get_session(db, session_id, user_id) is None:
+            raise HTTPException(status_code=404, detail="Live session not found")
+        raise HTTPException(status_code=409, detail="This live session is not running")
+    return {"session": await repository.get_session(db, session_id, user_id)}
+
+
+@router.delete("/sessions/{session_id}")
+async def delete_session(session_id: str, request: Request, db: AsyncSession = Depends(get_db)):
+    _require_enabled()
+    user_id = await resolve_authenticated_user_id(request, db, get_config())
+    if not await repository.delete_session(db, session_id, user_id):
+        if await repository.get_session(db, session_id, user_id) is None:
+            raise HTTPException(status_code=404, detail="Live session not found")
+        raise HTTPException(status_code=409, detail="Stop the live session before deleting it")
+    folder = live_root() / session_id
+    if folder.is_dir():
+        await run_in_thread(shutil.rmtree, folder, True)
+    return {"deleted": True}
+
+
+@router.get("/clips/{clip_id}/file")
+async def clip_file(clip_id: str, request: Request, kind: str = "clip", db: AsyncSession = Depends(get_db)):
+    _require_enabled()
+    if kind not in ("clip", "preview"):
+        raise HTTPException(status_code=422, detail="kind must be clip or preview")
+    user_id = await resolve_authenticated_user_id(request, db, get_config())
+    path = await repository.get_clip_file(db, clip_id, user_id, kind)
+    if not path:
+        raise HTTPException(status_code=404, detail="File not ready")
+    file = Path(path).resolve()
+    root = live_root().resolve()
+    if root not in file.parents or not file.is_file():
+        raise HTTPException(status_code=404, detail="File not found")
+    return FileResponse(file, media_type="video/mp4", filename=f"live_{kind}_{clip_id[:8]}.mp4")
diff --git a/backend/src/live/finisher.py b/backend/src/live/finisher.py
new file mode 100644
index 0000000..357fed0
--- /dev/null
+++ b/backend/src/live/finisher.py
@@ -0,0 +1,77 @@
+"""Render one live window as a finished vertical clip.
+
+The window (already cut to the hook-first span by ``moments.speech_window``)
+becomes a single clip through the same engine a task uses: transcript, EDL
+for the niche profile, the Auto template's music, the subject-aware reframe
+plan, and ``create_optimized_clip``, with the gaming "face on top, game
+below" layout when one is chosen. Captions carry the streamer's words only
+when ``streamer_words_only`` is set (default for gaming).
+"""
+from __future__ import annotations
+
+import logging
+import subprocess
+from pathlib import Path
+from typing import Any, Dict, Optional
+
+from .moments import keep_streamer_words
+
+logger = logging.getLogger(__name__)
+
+LAYOUTS = ("facecam_red", "facecam_gold")
+
+
+def _duration(path: Path) -> float:
+    out = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0",
+                          str(path)], capture_output=True, text=True).stdout.strip()
+    try:
+        return float(out or 0)
+    except ValueError:
+        return 0.0
+
+
+def render_live_clip(window: Path, out_path: Path, *, niche: str = "gaming", layout_template: Optional[str] = "facecam_red",
+                     credit: Optional[str] = None, hook_title: Optional[str] = None,
+                     streamer_words_only: bool = True) -> Dict[str, Any]:
+    """Render ``window`` into ``out_path``; returns ``{ok, duration, words, error}``."""
+    from ..auto_director import edl as E
+    from ..media.gaming_templates import clean_layout_credit
+    from ..media.music_library import apply_auto_music_bed
+    from ..media.reframe_plan import attach_reframe_plan
+    from ..media.transcription import get_video_transcript, load_cached_transcript_data
+    from ..video_utils import create_optimized_clip
+
+    window, out_path = Path(window), Path(out_path)
+    out_path.parent.mkdir(parents=True, exist_ok=True)
+    if layout_template not in LAYOUTS:
+        layout_template = None
+    total = _duration(window)
+    if total <= 1.0:
+        return {"ok": False, "error": "window is empty"}
+    try:
+        get_video_transcript(window)
+        data = load_cached_transcript_data(window) or {}
+    except Exception as exc:  # a clip without captions beats no clip
+        logger.warning("Live clip transcript failed: %s", exc)
+        data = {}
+    if streamer_words_only and data.get("words"):
+        try:
+            data = keep_streamer_words(window, data)
+        except Exception as exc:
+            logger.warning("Live clip streamer-word filter failed: %s", exc)
+    words = [{"word": str(w.get("text", "")).strip(), "text": str(w.get("text", "")).strip(),
+              "start": float(w.get("start", 0)) / 1000.0, "end": float(w.get("end", 0)) / 1000.0}
+             for w in data.get("words") or []]
+    profile = E.load_profile(niche)
+    clip_info = {"id": out_path.stem, "start": 0.0, "end": total, "duration": total}
+    edl = E.build_edl(clip_info, words, profile, energy_peaks=[], broll_enabled=False)
+    apply_auto_music_bed(edl, niche)
+    attach_reframe_plan(edl, window, [(0.0, total)], False, framing=None)
+    ok = create_optimized_clip(window, 0.0, total, out_path, add_subtitles=True,
+                               caption_template=(profile.get("captions") or {}).get("preset_id") or "default",
+                               hook_title=hook_title, edl=edl, profile_name=niche, layout_report={},
+                               framing_mode="auto", layout_template=layout_template,
+                               layout_credit=clean_layout_credit(credit) if layout_template else None)
+    ok = bool(ok) and out_path.is_file()
+    return {"ok": ok, "duration": round(_duration(out_path), 2) if ok else None, "words": len(words),
+            "error": None if ok else "render failed"}
diff --git a/backend/src/live/moments.py b/backend/src/live/moments.py
new file mode 100644
index 0000000..fd06022
--- /dev/null
+++ b/backend/src/live/moments.py
@@ -0,0 +1,174 @@
+"""From a live reaction flag to a clip worth posting.
+
+- ``speech_window``: where the clip starts and stops. It opens at most
+  ``lead_max`` seconds before the reaction, so the hook comes first (the
+  owner's review: "20 sec that streamer is not even talking, where is the
+  hook?"), and runs on while the streamer keeps talking.
+- ``creator_on_camera``: the streamer must be visible in the facecam and
+  clearly moving at the reaction. On a stream the game and the mic share one
+  audio track, so a voice flag can be game characters in a cutscene.
+- ``keep_streamer_words``: transcript words spoken while a game subtitle is
+  on screen are the game's lines, not the streamer's, and are not captioned.
+"""
+from __future__ import annotations
+
+import json
+import logging
+import subprocess
+from pathlib import Path
+from typing import Dict, Optional, Sequence, Tuple
+
+logger = logging.getLogger(__name__)
+
+
+def speech_window(voiced: Sequence[float], onset: float, end: float, *, lead_max: float = 6.0,
+                  min_len: float = 12.0, max_len: float = 30.0, talk_frac: float = 0.25,
+                  tail_gap: int = 2) -> Tuple[float, float, float]:
+    """``(start, stop, talk_share)`` in the seconds of ``voiced``.
+
+    ``voiced[i]`` is the voiced fraction of second ``i``. The start walks back
+    from the onset over the speech leading into it (at most ``lead_max`` s,
+    and at least 2 s of lead-in). The stop is the first silence longer than
+    ``tail_gap`` s after the flag; the length stays in [min_len, max_len].
+    ``talk_share`` is the fraction of seconds in the window with speech.
+    """
+    n = len(voiced)
+    talking = [float(v) >= talk_frac for v in voiced]
+    s = max(0, min(int(onset), n))
+    start = s
+    while (start - 1 >= 0 and onset - (start - 1) <= lead_max
+           and (talking[start - 1] or (start - 2 >= 0 and talking[start - 2]))):
+        start -= 1
+    start = min(start, max(0, s - 2))
+    stop, gap = min(n, int(end) + 1), 0
+    while stop < n and stop - start < max_len:
+        gap = 0 if talking[stop] else gap + 1
+        if gap > tail_gap:
+            stop -= gap - 1
+            break
+        stop += 1
+    stop = min(max(stop, start + int(min_len)), start + int(max_len))
+    if n:
+        stop = min(stop, n)
+    share = sum(talking[start:stop]) / max(1, stop - start)
+    return float(start), float(stop), share
+
+
+def _probe_size(video: Path) -> Optional[Tuple[int, int]]:
+    out = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries",
+                          "stream=width,height", "-of", "csv=p=0", str(video)], capture_output=True, text=True)
+    try:
+        w, h = [int(x) for x in out.stdout.strip().split(",")[:2]]
+        return w, h
+    except ValueError:
+        return None
+
+
+def creator_on_camera(window: Path, onset_in_window: float, *, min_ratio: float = 1.8) -> Tuple[bool, str]:
+    """Is the streamer's face visible in the facecam, and moving, at the reaction?
+
+    Visible in >= 2 of 3 facecam frames (onset-1, +1, +3 s) and the face's
+    movement at the moment >= ``min_ratio`` x its median in the rest of the
+    window. Returns ``(ok, reason)``.
+    """
+    import numpy as np
+
+    from ..auto_director.reaction_moments import extract_face_activity
+    from ..media.face_detection import open_yunet_detector
+    from ..media.facecam_rect import find_facecam_rect, probe_times
+
+    size = _probe_size(window)
+    if size is None:
+        return False, "window has no video"
+    w, h = size
+    dur = float(subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0",
+                                str(window)], capture_output=True, text=True).stdout.strip() or 0)
+    found = find_facecam_rect(str(window), w, h, probe_times([(0.0, max(dur, 1.0))]))
+    if found is None:
+        return False, "no facecam found"
+    x, y, cw, ch = [int(v) for v in found.rect]
+    detector = open_yunet_detector()
+    hits = 0
+    for t in (onset_in_window - 1, onset_in_window + 1, onset_in_window + 3):
+        raw = subprocess.run(["ffmpeg", "-v", "error", "-ss", f"{max(0.0, t):.2f}", "-i", str(window),
+                              "-frames:v", "1", "-vf", f"crop={cw}:{ch}:{x}:{y}", "-f", "rawvideo",
+                              "-pix_fmt", "bgr24", "pipe:1"], capture_output=True).stdout
+        if len(raw) >= cw * ch * 3:
+            frame = np.frombuffer(raw[: cw * ch * 3], dtype=np.uint8).reshape(ch, cw, 3)
+            if detector is not None and detector.detect(frame):
+                hits += 1
+    if hits < 2:
+        return False, f"face visible in only {hits}/3 facecam frames (cutscene or game voices)"
+    activity = extract_face_activity(str(window), (x / w, y / h, cw / w, ch / h))
+    if len(activity) < 10:
+        return True, f"face visible {hits}/3 (movement not measurable)"
+    lo, hi = int(max(0, onset_in_window - 2)), int(min(len(activity), onset_in_window + 5))
+    at_moment = float(np.max(activity[lo:hi])) if hi > lo else 0.0
+    rest = np.concatenate([activity[:lo], activity[hi:]])
+    base = float(np.median(rest)) if len(rest) else 0.0
+    ratio = at_moment / max(base, 1e-6)
+    if ratio >= min_ratio:
+        return True, f"face visible {hits}/3 and moving at the moment ({ratio:.1f}x usual)"
+    return False, f"face visible but still at the moment ({ratio:.1f}x usual): the voices were not a reaction"
+
+
+# Game subtitles (GTA VI and most games): white text with a dark outline,
+# bottom centre. Per second, the share of bright colourless pixels touching
+# dark ones in that zone x 1000. Measured on stream windows: 2.4-13.7 with a
+# subtitle, exactly 0.0 without.
+GAME_SUBTITLE_SCORE = 1.5
+
+
+def game_subtitle_seconds(video: Path) -> list:
+    import cv2
+    import numpy as np
+
+    capture = cv2.VideoCapture(str(video))
+    fps = float(capture.get(cv2.CAP_PROP_FPS) or 30.0)
+    total = int(capture.get(cv2.CAP_PROP_FRAME_COUNT) or 0)
+    seconds = int(total / fps) if fps else 0
+    kernel = np.ones((3, 3), np.uint8)
+    flags = []
+    for sec in range(seconds + 1):
+        capture.set(cv2.CAP_PROP_POS_FRAMES, int(min(max(total - 1, 0), (sec + 0.5) * fps)))
+        ok, frame = capture.read()
+        score = 0.0
+        if ok:
+            h, w = frame.shape[:2]
+            band = frame[int(h * 0.80):int(h * 0.95), int(w * 0.25):int(w * 0.75)]
+            hsv = cv2.cvtColor(band, cv2.COLOR_BGR2HSV)
+            white = (hsv[..., 2] > 215) & (hsv[..., 1] < 40)
+            near_dark = cv2.dilate((hsv[..., 2] < 90).astype(np.uint8), kernel) > 0
+            score = float((white & near_dark).mean()) * 1000.0
+        flags.append(score >= GAME_SUBTITLE_SCORE)
+    capture.release()
+    return flags
+
+
+def drop_game_words(words: list, game_sub: Sequence[bool]) -> list:
+    """Words (ms timings) not overlapping any second with a game subtitle."""
+    kept = []
+    for word in words:
+        st, en = float(word.get("start", 0)) / 1000.0, float(word.get("end", 0)) / 1000.0
+        secs = range(int(st), int(en) + 1)
+        if not any(0 <= s < len(game_sub) and game_sub[s] for s in secs):
+            kept.append(word)
+    return kept
+
+
+def keep_streamer_words(source: Path, data: Dict) -> Dict:
+    """Filter the transcript (and its cache, which the caption builder reads)."""
+    words = data.get("words") or []
+    if not words:
+        return data
+    kept = drop_game_words(words, game_subtitle_seconds(source))
+    cache = source.with_suffix(".transcript_cache.json")
+    if cache.exists():
+        full = source.with_suffix(".transcript_cache.full.json")
+        if not full.exists():
+            full.write_text(cache.read_text(encoding="utf-8"), encoding="utf-8")
+        cached = json.loads(cache.read_text(encoding="utf-8"))
+        cached["words"] = kept
+        cache.write_text(json.dumps(cached), encoding="utf-8")
+    logger.info("Live captions: kept %d of %d words (game subtitles removed)", len(kept), len(words))
+    return {**data, "words": kept}
