@@ -0,0 +1,171 @@
+"""Editing recommendations for reaction clips, emitted as DATA for the renderer.
+
+This lane decides WHAT should happen; the render lane (Lane B) decides HOW.
+Every recommendation carries a confidence and the evidence it rests on, and the
+whole block is advisory: a renderer may ignore any item.
+
+Document contract (``moment["edit_recommendations"]``), times are clip-relative
+seconds:
+
+{
+  "schema_version": 1,
+  "framing": {"mode": "auto|fit|crop", "layout": "facecam_split|game_with_facecam_inset|game_only",
+              "facecam_roi": [x, y, w, h] | null, "reason": str, "confidence": 0-1},
+  "zooms":   [{"start": s, "end": s, "target": "facecam|center", "from_scale": 1.0,
+               "to_scale": 1.12, "ease": "out_cubic", "reason": str}],
+  "pacing":  {"trim_dead_time": [{"start": s, "end": s, "reason": str}],
+              "speed": [{"start": s, "end": s, "rate": 0.6, "reason": str}],
+              "open_on": "reaction|trigger", "reason": str},
+  "sfx_cues": [{"at": s, "kind": "impact|riser", "requires_library": true, "reason": str}]
+}
+"""
+
+from __future__ import annotations
+
+from typing import Any, Optional, Sequence
+
+SCHEMA_VERSION = 1
+_MAX_ZOOM = 1.15
+
+
+def _clip_time(value: Optional[float], window_start: float) -> Optional[float]:
+    return None if value is None else round(max(0.0, float(value) - window_start), 2)
+
+
+def recommend_framing(
+    facecam_roi: Optional[tuple[float, float, float, float]], mtype: str, kind: str
+) -> dict[str, Any]:
+    if facecam_roi is None:
+        return {"mode": "fit", "layout": "game_only", "facecam_roi": None, "confidence": 0.5,
+                "reason": "no facecam found: keep the full game frame so HUD stays readable"}
+    reaction_led = mtype in ("reaction_to_event", "commentary_reaction")
+    layout = "facecam_split" if reaction_led else "game_with_facecam_inset"
+    return {
+        "mode": "fit", "layout": layout, "facecam_roi": [round(v, 3) for v in facecam_roi],
+        "confidence": 0.8 if reaction_led else 0.6,
+        "reason": ("the reaction is the point of the clip: give the facecam its own panel "
+                   "above the game" if reaction_led else
+                   "game-led clip: keep the facecam as a small inset"),
+    }
+
+
+def recommend_zooms(
+    moment: dict[str, Any], window_start: float, window_len: float,
+    facecam_roi: Optional[tuple[float, float, float, float]],
+) -> list[dict[str, Any]]:
+    ev = moment.get("evidence") or {}
+    zooms: list[dict[str, Any]] = []
+    r0, r1 = ev.get("reaction_start_sec"), ev.get("reaction_end_sec")
+    if r0 is None or r1 is None:
+        return zooms
+    a = _clip_time(r0, window_start) or 0.0
+    b = min(window_len, _clip_time(r1, window_start) or 0.0)
+    kind = ev.get("reaction_kind")
+    if b - a >= 0.8:
+        strong = kind in ("shout", "laughter")
+        zooms.append({
+            "start": round(a - 0.15 if a >= 0.15 else a, 2), "end": round(min(window_len, b + 0.4), 2),
+            "target": "facecam" if facecam_roi else "center",
+            "from_scale": 1.0, "to_scale": 1.12 if strong else 1.07, "ease": "out_cubic",
+            "reason": "punch in as the reaction starts, hold through it, release after the payoff"})
+    game = ev.get("game_event")
+    if game:
+        g = _clip_time(game["start_sec"], window_start)
+        if g is not None and g + 0.6 < (a or window_len):
+            zooms.append({
+                "start": g, "end": round(min(window_len, g + 0.9), 2), "target": "center",
+                "from_scale": 1.0, "to_scale": 1.06, "ease": "out_cubic",
+                "reason": "small push on the on-screen trigger so viewers see what the streamer reacts to"})
+    for z in zooms:
+        z["to_scale"] = min(z["to_scale"], _MAX_ZOOM)
+    return zooms
+
+
+def recommend_pacing(
+    moment: dict[str, Any], window_start: float, window_len: float,
+    strength: Optional[Sequence[float]] = None, words: Optional[Sequence[dict[str, Any]]] = None,
+) -> dict[str, Any]:
+    ev = moment.get("evidence") or {}
+    game = ev.get("game_event")
+    r0 = ev.get("reaction_start_sec")
+    pacing: dict[str, Any] = {"trim_dead_time": [], "speed": [], "open_on": "trigger",
+                              "reason": "show the trigger first so the reaction has a cause"}
+    if not game:
+        pacing["open_on"] = "reaction"
+        pacing["reason"] = "no visible trigger: open directly on the reaction"
+    elif r0 is not None and r0 - game["end_sec"] > 4.0:
+        pacing["open_on"] = "reaction"
+        pacing["reason"] = "long gap between trigger and reaction: cold-open on the reaction"
+    # Dead time: stretches of >= 2.5 s with no speech and no reaction/event.
+    if strength is not None and window_len > 6:
+        quiet_start: Optional[int] = None
+        lo, hi = int(window_start), int(window_start + window_len)
+        for t in range(lo, hi + 1):
+            quiet = (t >= len(strength) or strength[t] <= 0)
+            if words:
+                quiet = quiet and not any(float(w["start"]) <= t + 1 and float(w["end"]) >= t for w in words)
+            if game and game["start_sec"] - 1 <= t <= game["end_sec"] + 1:
+                quiet = False
+            if quiet and quiet_start is None:
+                quiet_start = t
+            if (not quiet or t == hi) and quiet_start is not None:
+                if t - quiet_start >= 3:
+                    pacing["trim_dead_time"].append({
+                        "start": round(quiet_start - window_start + 0.4, 2),
+                        "end": round(t - window_start - 0.4, 2),
+                        "reason": "silence with nothing happening on screen"})
+                quiet_start = None
+    if game and ev.get("game_event", {}).get("type") in ("screen_flash_banner", "erratic_motion"):
+        g = _clip_time(game["start_sec"], window_start)
+        if g is not None and r0 is not None and r0 - game["start_sec"] >= 0.8:
+            pacing["speed"].append({
+                "start": g, "end": round(g + 0.8, 2), "rate": 0.6,
+                "reason": "brief slow-down on the trigger before the reaction lands"})
+    return pacing
+
+
+def recommend_sfx(moment: dict[str, Any], window_start: float) -> list[dict[str, Any]]:
+    """Cues only; the app's SFX library ships empty, so every cue says so."""
+    ev = moment.get("evidence") or {}
+    game = ev.get("game_event")
+    if not game:
+        return []
+    return [{"at": _clip_time(game["start_sec"], window_start), "kind": "impact",
+             "requires_library": True, "reason": "accent the on-screen trigger"}]
+
+
+def recommend_edits(
+    moment: dict[str, Any], window_start: float, window_end: float, *,
+    facecam_roi: Optional[tuple[float, float, float, float]] = None,
+    strength: Optional[Sequence[float]] = None,
+    words: Optional[Sequence[dict[str, Any]]] = None,
+) -> dict[str, Any]:
+    ev = moment.get("evidence") or {}
+    mtype = ev.get("moment_type", "")
+    window_len = max(0.0, window_end - window_start)
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "framing": recommend_framing(facecam_roi, mtype, ev.get("reaction_kind", "")),
+        "zooms": recommend_zooms(moment, window_start, window_len, facecam_roi),
+        "pacing": recommend_pacing(moment, window_start, window_len, strength, words),
+        "sfx_cues": recommend_sfx(moment, window_start),
+    }
+
+
+def attach_recommendations(
+    moments: list[dict[str, Any]], *,
+    facecam_roi: Optional[tuple[float, float, float, float]] = None,
+    strength: Optional[Sequence[float]] = None,
+    words: Optional[Sequence[dict[str, Any]]] = None,
+) -> list[dict[str, Any]]:
+    def sec(label: str) -> float:
+        m, x = label.split(":")
+        return int(m) * 60 + int(x)
+
+    for m in moments:
+        if "moment_type" not in (m.get("evidence") or {}):
+            continue
+        m["edit_recommendations"] = recommend_edits(
+            m, sec(m["start_time"]), sec(m["end_time"]),
+            facecam_roi=facecam_roi, strength=strength, words=words)
+    return moments
diff --git a/backend/src/auto_director/reaction_hooks.py b/backend/src/auto_director/reaction_hooks.py
new file mode 100644
index 0000000..d1017dd
--- /dev/null
+++ b/backend/src/auto_director/reaction_hooks.py
@@ -0,0 +1,237 @@
+"""GA2 for reaction clips: grounded hooks, payoff-aware boundaries, caption sync.
+
+Everything here is derived from MEASURED evidence on a moment (the
+``evidence`` block written by ``reaction_moments``) and, when available, the
+transcript's word timings. Nothing names a game, a weapon or an event the
+pictures and sound did not show; a hook never claims more than the evidence
+supports ("a sudden on-screen blast", not "a car explodes").
+
+Pure functions, no I/O: the pipeline and the tests call them directly.
+"""
+
+from __future__ import annotations
+
+import re
+import zlib
+from typing import Any, Optional, Sequence
+
+_TRIGGER_PHRASE = {
+    "screen_flash_banner": "a sudden on-screen blast",
+    "hud_event_streak": "a burst of on-screen action",
+    "erratic_motion": "everything going wildly wrong",
+    "sustained_escalation": "an intense on-screen sequence",
+    "visual_change": "something unexpected on screen",
+}
+_EVENT_HOOKS = {
+    "laughter": ("Streamer loses it laughing at {t}", "Streamer can't stop laughing at {t}",
+                 "Streamer cracks up over {t}"),
+    "shout": ("Streamer screams at {t}", "Streamer erupts after {t}", "Streamer panics at {t}"),
+    "vocal_burst": ("Streamer reacts loudly to {t}", "Streamer blurts out at {t}",
+                    "Streamer is stunned by {t}"),
+}
+_COMMENTARY_HOOKS = {
+    "laughter": ("Streamer bursts out laughing mid-stream", "Streamer completely loses it laughing",
+                 "Streamer cracks up out of nowhere"),
+    "shout": ("Streamer suddenly erupts mid-commentary", "Streamer's wild outburst out of nowhere",
+              "Streamer goes off unexpectedly"),
+    "vocal_burst": ("Streamer's unexpected outburst", "Streamer blurts out something unexpected",
+                    "Streamer reacts out of nowhere"),
+}
+_SILENT_HOOKS = ("Streamer's silent reaction says it all", "Streamer goes quiet at the worst moment")
+
+_PROFANITY = re.compile(r"\b(fuck\w*|shit\w*|bitch\w*|asshole|damn|crap|dick)\b", re.I)
+
+
+def mask_profanity(text: str, mode: str = "mask") -> str:
+    """User-configurable profanity handling: keep | mask | drop."""
+    if mode == "keep":
+        return text
+    if mode == "drop":
+        return re.sub(r"\s{2,}", " ", _PROFANITY.sub("", text)).strip()
+    return _PROFANITY.sub(lambda m: m.group(0)[0] + "*" * (len(m.group(0)) - 1), text)
+
+
+def _pick(options: Sequence[str], seed: str) -> str:
+    return options[zlib.crc32(seed.encode()) % len(options)]
+
+
+def reaction_hook_title(moment: dict[str, Any]) -> Optional[str]:
+    """A 3–9 word third-person hook grounded in the moment's evidence, or None
+    when the moment is a plain gameplay pick (those keep their own hooks)."""
+    ev = moment.get("evidence") or {}
+    mtype = ev.get("moment_type")
+    if mtype is None:
+        return None
+    kind = ev.get("reaction_kind") or "vocal_burst"
+    seed = f"{moment.get('start_time')}{mtype}{kind}"
+    if mtype == "reaction_to_event":
+        game = ev.get("game_event") or {}
+        trigger = _TRIGGER_PHRASE.get(game.get("type"), _TRIGGER_PHRASE["visual_change"])
+        title = _pick(_EVENT_HOOKS.get(kind, _EVENT_HOOKS["vocal_burst"]), seed).format(t=trigger)
+    elif mtype == "commentary_reaction":
+        title = _pick(_COMMENTARY_HOOKS.get(kind, _COMMENTARY_HOOKS["vocal_burst"]), seed)
+    elif mtype == "silent_facecam":
+        title = _pick(_SILENT_HOOKS, seed)
+    else:
+        return None
+    return title if 3 <= len(title.split()) <= 9 else " ".join(title.split()[:9])
+
+
+def reaction_quote(words: Sequence[dict[str, Any]], start: float, end: float,
+                   profanity: str = "mask", max_words: int = 6) -> Optional[str]:
+    """The streamer's own words at the reaction (verbatim, never rewritten).
+    Returns None when nobody spoke intelligibly there."""
+    spoken = [w for w in words if start - 0.2 <= float(w["start"]) <= end + 0.2]
+    if not spoken:
+        return None
+    text = " ".join(str(w["text"]) for w in spoken[:max_words]).strip()
+    return mask_profanity(text, profanity) or None
+
+
+# --------------------------------------------------------------------------
+# Boundaries
+# --------------------------------------------------------------------------
+
+def refine_window(
+    start: float,
+    end: float,
+    reaction_start: float,
+    reaction_end: float,
+    duration: float,
+    words: Optional[Sequence[dict[str, Any]]] = None,
+    strength: Optional[Sequence[float]] = None,
+) -> tuple[float, float, list[str]]:
+    """Snap a window to speech boundaries and finish on the payoff.
+
+    * never starts or ends inside a spoken word;
+    * starts on a pause (>= 0.3 s gap) found within 2.5 s before ``start``;
+    * ends after the reaction has really died down: it extends while the
+      reaction-strength series is still active (up to 4 s) and then past the
+      last word that begins within a second of that point;
+    * always keeps >= 2 s after the reaction ends.
+    Returns (start, end, notes) — notes name every adjustment made.
+    """
+    notes: list[str] = []
+    s, e = start, end
+    if strength is not None and len(strength):
+        t = int(reaction_end)
+        extra = 0
+        while extra < 4 and t + extra < len(strength) and strength[t + extra] > 0:
+            extra += 1
+        if extra and reaction_end + extra + 1.5 > e:
+            e = reaction_end + extra + 1.5
+            notes.append(f"extended end {extra}s: reaction still active")
+    if e < reaction_end + 2.0:
+        e = reaction_end + 2.0
+        notes.append("kept 2s of payoff after the reaction")
+    if words:
+        ws = [(float(w["start"]), float(w["end"])) for w in words]
+        for ws_, we_ in ws:
+            if ws_ < s < we_:
+                s = ws_
+                notes.append("moved start to the start of the word it cut")
+                break
+        else:
+            gaps = [ws[i + 1][0] for i in range(len(ws) - 1)
+                    if ws[i + 1][0] - ws[i][1] >= 0.3 and s - 2.5 <= ws[i + 1][0] <= s]
+            if gaps:
+                s = max(gaps)
+                notes.append("started on a pause between sentences")
+        for ws_, we_ in ws:
+            if ws_ < e < we_:
+                e = we_ + 0.25
+                notes.append("moved end past the word it cut")
+                break
+    return max(0.0, s), min(float(duration), e), notes
+
+
+# --------------------------------------------------------------------------
+# Caption synchronisation
+# --------------------------------------------------------------------------
+
+def caption_plan(
+    moment: dict[str, Any],
+    window_start: float,
+    words: Optional[Sequence[dict[str, Any]]] = None,
+    facecam_roi: Optional[tuple[float, float, float, float]] = None,
+    profanity: str = "mask",
+) -> dict[str, Any]:
+    """Caption timing/placement data for the renderer (times are clip-relative).
+
+    * emphasis spans sit on the REACTION (measured voice onset), not on the
+      loudest game sound;
+    * an on-screen-event cue is aligned to when the event appears on screen;
+    * placement keeps captions off the facecam rectangle.
+    Words are never altered except for the user's profanity setting.
+    """
+    ev = moment.get("evidence") or {}
+    r0 = ev.get("reaction_start_sec")
+    r1 = ev.get("reaction_end_sec")
+    plan: dict[str, Any] = {"profanity_mode": profanity, "emphasis": [], "event_cue": None,
+                            "words_modified": profanity != "keep"}
+    if r0 is not None and r1 is not None:
+        plan["emphasis"] = [{
+            "start": round(max(0.0, r0 - window_start), 2),
+            "end": round(max(0.0, r1 - window_start), 2),
+            "style": "laugh" if ev.get("reaction_kind") == "laughter" else "shout",
+            "reason": "measured reaction span",
+        }]
+        if words:
+            plan["emphasis_words"] = [
+                {"text": mask_profanity(str(w["text"]), profanity),
+                 "start": round(float(w["start"]) - window_start, 2),
+                 "end": round(float(w["end"]) - window_start, 2)}
+                for w in words if r0 - 0.2 <= float(w["start"]) <= r1 + 0.2]
+    game = ev.get("game_event")
+    if game:
+        plan["event_cue"] = {"at": round(max(0.0, game["start_sec"] - window_start), 2),
+                             "align_to": "event_start", "not_audio_peak": True}
+    plan["position"] = caption_position(facecam_roi)
+    return plan
+
+
+def caption_position(roi: Optional[tuple[float, float, float, float]]) -> dict[str, Any]:
+    """Where captions should sit so they do not cover the facecam or the
+    bottom-of-screen HUD. Default is the lower-middle band the app uses."""
+    if roi is None:
+        return {"vertical": "lower_third", "avoid": ["bottom_hud"]}
+    x, y, w, h = roi
+    centre_y = y + h / 2
+    return {"vertical": "upper_third" if centre_y > 0.5 else "lower_third",
+            "avoid": ["facecam", "bottom_hud"], "facecam_roi": [round(v, 3) for v in roi]}
+
+
+def apply_ga2(
+    moments: list[dict[str, Any]],
+    duration: float,
+    *,
+    words: Optional[Sequence[dict[str, Any]]] = None,
+    strength: Optional[Sequence[float]] = None,
+    facecam_roi: Optional[tuple[float, float, float, float]] = None,
+    profanity: str = "mask",
+) -> list[dict[str, Any]]:
+    """Fill hook, refined boundaries and caption plan on reaction moments."""
+    from .gameplay_moments import _mmss
+
+    def sec(label: str) -> float:
+        m, x = label.split(":")
+        return int(m) * 60 + int(x)
+
+    for m in moments:
+        ev = m.get("evidence") or {}
+        if "moment_type" not in ev:
+            continue
+        s, e, notes = refine_window(
+            sec(m["start_time"]), sec(m["end_time"]),
+            ev["reaction_start_sec"], ev["reaction_end_sec"], duration, words, strength)
+        m["start_time"], m["end_time"] = _mmss(s), _mmss(e)
+        ev["boundary_notes"] = notes
+        title = reaction_hook_title(m)
+        if title and not m.get("hook_title"):
+            m["hook_title"] = title
+        if words:
+            q = reaction_quote(words, ev["reaction_start_sec"], ev["reaction_end_sec"], profanity)
+            if q:
+                ev["hook_quote"] = q
+        m["caption_plan"] = caption_plan(m, s, words, facecam_roi, profanity)
+    return moments
