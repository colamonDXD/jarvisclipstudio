+    print(f"  positives found {len(pos_hit)}/{len(pos)}: {sorted(pos_hit)}; missed {sorted(set(pos)-pos_hit)}; false-positive picks: {fp}")
+    return {"found": len(pos_hit), "of": len(pos), "fp": len(fp), "n": len(ms)}
