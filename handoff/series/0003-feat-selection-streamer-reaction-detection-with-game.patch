+def sec(s): m, x = s.split(":"); return int(m) * 60 + int(x)
+
+def where(m):
+    s, e = sec(m["start_time"]), sec(m["end_time"])
+    best = max(plan, key=lambda p: max(0, min(e, p["end"]) - max(s, p["start"])))
+    ov = max(0, min(e, best["end"]) - max(s, best["start"]))
+    return best, ov
+
+def report(label, ms, t):
