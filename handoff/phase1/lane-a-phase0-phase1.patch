+def _phrase_at(tokens: list[str], i: int, phrase: tuple[str, ...]) -> bool:
+    if i + len(phrase) > len(tokens):
+        return False
+    for k, part in enumerate(phrase):
+        if not _token_matches(tokens[i + k], part, k == len(phrase) - 1):
+            return False
+    return True
