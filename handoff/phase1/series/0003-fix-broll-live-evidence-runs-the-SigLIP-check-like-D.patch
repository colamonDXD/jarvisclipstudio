             item = {"start": b.get("start"), "end": b.get("end"), "spoken": b.get("spoken"), "query": b.get("search_query"),
-                    "layout": b.get("layout"), "cue_source": b.get("cue_source")}
+                    "layout": b.get("layout"), "cue_source": b.get("cue_source"),
+                    "veto_checked": bool(veto.get("checked")), "veto_rejected": len(veto.get("vetoed") or [])}
