new file mode 100644
index 0000000..fb9ab3c
--- /dev/null
+++ b/backend/src/live/chat_signals.py
@@ -0,0 +1,137 @@
+"""Per-second chat signals: message rate, unique chatters, hype share.
+
+Pure functions over ``[(t_sec, author, text)]`` from ``live.chat_replay``.
+No I/O, so the same series can be built in a test from a list of tuples and
+in production from a downloaded replay.
+
+``hype`` is the share of a second's messages that carry a laugh/hype token,
+so a quiet second that is one "KEKW" and a busy second where half the chat
+laughs are both 0..1. A caller that wants "chat exploded" should look at
+``rate`` and ``hype`` together, or use ``chat_zscores``, which normalises
+all three against the causal baseline in ``live.selection.causal_z``. That
+baseline is deliberately reused, not reimplemented: a second is compared
+with the minutes before it, never with the stream's future.
+
+A second with no messages has ``hype = 0.0``; ``rate`` and ``unique`` are
+counts. Seconds are ``ceil(duration)`` long, and messages outside
+``[0, duration)`` are ignored.
+"""
+from __future__ import annotations
+
+import math
+import re
+from typing import Any, Dict, Iterable, List, Sequence, Tuple
+
+import numpy as np
+
+from .selection import DEFAULT_PARAMS, causal_z
+
+CHAT_FLOORS = {"rate": 1.0, "unique": 1.0, "hype": 0.05}
+_HYPE_WORDS = frozenset({"LUL", "KEKW", "OMEGALUL", "LMAO", "LOL", "W", "L"})
+_HYPE_EMOJI = ("\U0001F602", "\U0001F480", "\U0001F525")  # 😂 💀 🔥
+# yt-dlp renders a custom emoji as a ``:shortcut:`` run when the chat item
+# has no text for it, so the same three emoji need their names too.
+_HYPE_SHORTCUTS = (
+    ":rolling_on_the_floor_laughing:",
+    ":face_with_tears_of_joy:",
+    ":joy:",
+    ":skull:",
+    ":skull_crossbones:",
+    ":fire:",
+    ":lul:",
+    ":kekw:",
+    ":omegalul:",
+    ":lmao:",
+    ":lol:",
+)
+_WORD_RE = re.compile(r"[A-Za-z]+")
+_QUESTIONS_RE = re.compile(r"\?{3,}")
+_CASED_RE = re.compile(r"[A-Za-z]")
+
+
+def is_hype_message(text: str) -> bool:
+    """Whether one chat message carries a laugh/hype token.
+
+    The token list is the one in the round-4 brief: LUL, KEKW, OMEGALUL,
+    LMAO, LOL, 😂, 💀, 🔥, a lone W or L, a run of question marks, or an
+    all-caps message (at least four letters, so "GG" does not count).
+    """
+    if not text:
+        return False
+    if any(word.upper() in _HYPE_WORDS for word in _WORD_RE.findall(text)):
+        return True
+    if any(emoji in text for emoji in _HYPE_EMOJI):
+        return True
+    lowered = text.lower()
+    if any(shortcut in lowered for shortcut in _HYPE_SHORTCUTS):
+        return True
+    if _QUESTIONS_RE.search(text):
+        return True
+    letters = _CASED_RE.findall(text)
+    return len(letters) >= 4 and all(letter.isupper() for letter in letters)
+
+
+def chat_series(
+    messages: Iterable[Tuple[float, str, str]], duration: float
+) -> Dict[str, List[float]]:
+    """Per-second ``rate``, ``unique`` and ``hype`` for a chat replay.
+
+    ``rate[t]`` is messages in second ``t``, ``unique[t]`` is distinct
+    authors (an empty author counts as one), and ``hype[t]`` is the share
+    of that second's messages for which ``is_hype_message`` is true.
+    """
+    seconds = max(0, int(math.ceil(float(duration or 0.0))))
+    rate = [0] * seconds
+    hype: List[float] = [0.0] * seconds
+    hype_counts = [0] * seconds
+    authors: List[set] = [set() for _ in range(seconds)]
+
+    for message in messages:
+        try:
+            moment, author, text = message
+        except (TypeError, ValueError):
+            continue
+        try:
+            moment = float(moment)
+        except (TypeError, ValueError):
+            continue
+        if not math.isfinite(moment):
+            continue
+        index = int(moment)
+        if index < 0 or index >= seconds:
+            continue
+        rate[index] += 1
+        authors[index].add(str(author or ""))
+        if is_hype_message(str(text or "")):
+            hype_counts[index] += 1
+
+    for index, count in enumerate(rate):
+        if count:
+            hype[index] = hype_counts[index] / count
+    return {
+        "rate": rate,
+        "unique": [len(names) for names in authors],
+        "hype": hype,
+    }
+
+
+def chat_zscores(
+    series: Dict[str, Sequence[float]], params: Dict[str, float] | None = None
+) -> Dict[str, np.ndarray]:
+    """Causal z-scores for each chat series, using ``selection.causal_z``.
+
+    ``params`` takes the same keys as ``selection.DEFAULT_PARAMS``
+    (``baseline_sec``, ``exclude_sec``, ``min_baseline``); anything omitted
+    keeps the product defaults.
+    """
+    p = dict(DEFAULT_PARAMS, **(params or {}))
+    return {
+        name: causal_z(
+            np.asarray(series.get(name) or [], dtype=np.float64),
+            floor,
+            int(p["baseline_sec"]),
+            int(p["exclude_sec"]),
+            int(p["min_baseline"]),
+        )
+        for name, floor in CHAT_FLOORS.items()
+    }
