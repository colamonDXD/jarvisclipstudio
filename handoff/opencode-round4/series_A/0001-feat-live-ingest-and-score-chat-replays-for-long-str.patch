+"""Chat replay ingestion: YouTube line JSON, TwitchDownloaderCLI JSON."""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from src.live import chat_replay
+
+FIXTURES = Path(__file__).resolve().parents[1] / "fixtures" / "chat"
+YOUTUBE = FIXTURES / "sample_youtube.live_chat.json"
+TWITCH = FIXTURES / "sample_twitch.json"
+
+
+def test_youtube_replay_is_parsed_into_timed_messages():
+    messages = chat_replay.load_messages(YOUTUBE)
+
+    # The fixture carries 320 text messages; the three engagement notices in
+    # it have no chat text and must be skipped.
+    assert len(messages) == 320
+    assert [moment for moment, _, _ in messages] == sorted(
+        moment for moment, _, _ in messages
+    )
+    assert all(author for _, author, _ in messages)
+    assert all(text for _, _, text in messages)
+    assert messages[0][0] < messages[-1][0]
+    assert any("LUL" in text for _, _, text in messages)
+    assert any("😂" in text for _, _, text in messages)
+
+
+def test_twitch_downloader_json_is_parsed_into_timed_messages():
+    messages = chat_replay.load_messages(TWITCH)
+
+    assert len(messages) == 280
+    assert all(0 <= moment < 900 for moment, _, _ in messages)
+    assert [moment for moment, _, _ in messages] == sorted(
+        moment for moment, _, _ in messages
+    )
+    assert {author for _, author, _ in messages} == {
+        f"chatter{index}" for index in range(1, 39)
+    }
+    assert any("KEKW" in text for _, _, text in messages)
+
+
+def test_whole_file_youtube_record_and_bad_lines_are_accepted(tmp_path):
+    record = {
+        "replayChatItemAction": {
+            "actions": [
+                {
+                    "addChatItemAction": {
+                        "item": {
+                            "liveChatTextMessageRenderer": {
+                                "message": {"runs": [{"text": "single LUL"}]},
+                                "authorName": {"simpleText": "solo"},
+                            }
+                        }
+                    }
+                }
+            ],
+            "videoOffsetTimeMsec": "4200",
+        }
+    }
