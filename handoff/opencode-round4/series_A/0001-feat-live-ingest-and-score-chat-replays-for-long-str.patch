index 0000000..89a1640
--- /dev/null
+++ b/backend/src/live/chat_replay.py
@@ -0,0 +1,217 @@
+"""Chat replay ingestion for long-stream moment finding.
+
+A finished stream keeps a transcript of its live chat on YouTube ("chat
+replay"); on Twitch it can be fetched with the open-source
+TwitchDownloaderCLI. Both are line/record oriented JSON, and both answer
+the same question: what did the audience say, and at what second of the
+video.
+
+This module only fetches and normalises. Scoring lives in
+``live.chat_signals``. Neither YouTube nor Twitch is required: a stream
+without a chat replay simply returns ``None``.
+
+Rules (handoff/round4): no undocumented API calls. YouTube is read through
+the same yt-dlp binary the rest of the VOD clipper uses. Twitch is read
+only through TwitchDownloaderCLI (MIT) when the user installed it.
+"""
+from __future__ import annotations
+
+import json
+import re
+import shutil
+import subprocess
+from pathlib import Path
+from typing import Any, Dict, Iterable, List, Optional, Tuple
+
+from . import yt_dlp_binary
+
+CHAT_MESSAGES = List[Tuple[float, str, str]]
+_TWITCH_VOD_RE = re.compile(r"twitch\.tv/videos/(\d+)")
+_TWITCH_CLI = "TwitchDownloaderCLI"
+
+
+def _chat_files(folder: Path) -> set:
+    return set(folder.glob("*.live_chat.json")) | set(folder.glob("*.json"))
+
+
+def fetch_youtube_chat(url: str, out_dir: Path, timeout: float = 900) -> Optional[Path]:
+    """Download the live-chat replay for ``url``; ``None`` when it has none.
+
+    yt-dlp writes ``<id>.live_chat.json`` for a stream that kept its chat.
+    Many streams disable the replay, so ``None`` is a normal answer, not an
+    error. Only a failed yt-dlp run with no earlier chat file raises.
+    """
+    folder = Path(out_dir)
+    folder.mkdir(parents=True, exist_ok=True)
+    before = _chat_files(folder)
+    command = [
+        yt_dlp_binary(), "--no-warnings", "-q", "--no-playlist",
+        "--skip-download", "--write-subs", "--sub-langs", "live_chat",
+        "-o", str(folder / "%(id)s.%(ext)s"), url,
+    ]
+    result = subprocess.run(command, capture_output=True, text=True, timeout=timeout)
+    new = sorted(_chat_files(folder) - before)
+    if new:
+        return new[0]
+    if result.returncode != 0:
+        detail = (result.stderr or "yt-dlp could not read the chat replay").strip()[-300:]
+        raise RuntimeError(detail)
+    return None
+
+
+def twitch_vod_id(url: str) -> Optional[str]:
+    match = _TWITCH_VOD_RE.search(url)
+    return match.group(1) if match else None
+
+
+def fetch_twitch_chat(url: str, out_dir: Path, timeout: float = 900) -> Optional[Path]:
+    """Download a Twitch VOD's chat with TwitchDownloaderCLI, if installed.
+
+    Returns ``None`` when the CLI is not on PATH, when the URL is not a VOD,
+    or when the download produced nothing. Install (not bundled): download
+    the release for the platform from
+    https://github.com/lay295/TwitchDownloader/releases and put
+    ``TwitchDownloaderCLI`` on PATH.
+    """
+    binary = shutil.which(_TWITCH_CLI)
+    vod_id = twitch_vod_id(url)
+    if not binary or not vod_id:
+        return None
+    folder = Path(out_dir)
+    folder.mkdir(parents=True, exist_ok=True)
+    output = folder / f"{vod_id}.twitch_chat.json"
+    command = [
+        binary, "chatdownload", "--id", vod_id,
+        "-o", str(output), "--collision", "Overwrite",
+    ]
+    try:
+        result = subprocess.run(command, capture_output=True, text=True, timeout=timeout)
+    except OSError:
+        return None
+    if result.returncode != 0 or not output.is_file() or output.stat().st_size == 0:
+        return None
+    return output
+
+
+def _message_text(runs: Iterable[Dict[str, Any]]) -> str:
+    parts: List[str] = []
+    for run in runs or ():
+        text = run.get("text")
+        if text:
+            parts.append(str(text))
+            continue
+        emoji = run.get("emoji") or {}
+        shortcuts = emoji.get("shortcuts") or []
+        if shortcuts:
+            parts.append(str(shortcuts[0]))
+    return "".join(parts)
+
+
+def _youtube_record(record: Dict[str, Any]) -> List[Tuple[float, str, str]]:
+    action = record.get("replayChatItemAction") or {}
+    offset_ms = action.get("videoOffsetTimeMsec")
+    if offset_ms is None:
+        return []
+    try:
+        seconds = int(offset_ms) / 1000.0
+    except (TypeError, ValueError):
+        return []
+    found: List[Tuple[float, str, str]] = []
+    for item in action.get("actions") or ():
+        renderer = ((item.get("addChatItemAction") or {}).get("item") or {}).get(
+            "liveChatTextMessageRenderer"
+        )
+        if not renderer:
+            continue
+        text = _message_text((renderer.get("message") or {}).get("runs") or ())
+        if not text:
+            continue
+        author = ((renderer.get("authorName") or {}).get("simpleText") or "").strip()
+        found.append((seconds, author, text))
+    return found
+
+
+def _twitch_comment(comment: Dict[str, Any]) -> Optional[Tuple[float, str, str]]:
+    seconds = comment.get("content_offset_seconds")
+    if seconds is None:
+        offset_ms = comment.get("message_offset_ms")
+        if offset_ms is None:
+            return None
+        seconds = float(offset_ms) / 1000.0
+    try:
+        seconds = float(seconds)
+    except (TypeError, ValueError):
+        return None
+    body = (comment.get("message") or {}).get("body")
+    if not body and comment.get("content_type") == "video":
+        return None
+    if body is None:
+        return None
+    commenter = comment.get("commenter") or {}
+    author = str(commenter.get("display_name") or commenter.get("name") or "").strip()
+    return seconds, author, str(body)
+
+
+def _records(payload: Any) -> Iterable[Dict[str, Any]]:
+    if isinstance(payload, dict):
+        if "replayChatItemAction" in payload:
+            yield payload
+            return
+        comments = payload.get("comments")
+        if isinstance(comments, list):
+            for comment in comments:
+                if isinstance(comment, dict):
+                    yield comment
+            return
+        if "message" in payload:
+            yield payload
+            return
+        return
+    if isinstance(payload, list):
+        for item in payload:
+            if isinstance(item, dict):
+                yield item
+
+
+def load_messages(path: Path) -> CHAT_MESSAGES:
+    """Read a YouTube or Twitch chat file into ``[(t_sec, author, text)]``.
+
+    Accepts yt-dlp's line-delimited ``.live_chat.json``, a whole-file JSON
+    object, TwitchDownloaderCLI's ``comments`` JSON, and a bare list of
+    either record type. Records without text or without a video offset
+    (subscription/engagement notices) are skipped. Output is sorted by time
+    and is stable for records that share a second.
+    """
+    text = Path(path).read_text(encoding="utf-8", errors="replace").strip()
+    if not text:
+        return []
+
+    records: List[Dict[str, Any]] = []
+    parsed_whole = False
+    if text[0] in "[{":
+        try:
+            records.extend(_records(json.loads(text)))
+            parsed_whole = True
+        except json.JSONDecodeError:
+            parsed_whole = False
+    if not parsed_whole:
+        for line in text.splitlines():
+            line = line.strip()
+            if not line:
+                continue
+            try:
+                records.extend(_records(json.loads(line)))
+            except json.JSONDecodeError:
+                continue
+
+    messages: List[Tuple[float, str, str]] = []
+    for record in records:
+        if "replayChatItemAction" in record:
+            messages.extend(_youtube_record(record))
+        else:
+            message = _twitch_comment(record)
+            if message is not None:
+                messages.append(message)
+
+    messages.sort(key=lambda message: message[0])
+    return messages
