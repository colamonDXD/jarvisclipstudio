+"""Per-second chat signals and their causal baseline."""
+from __future__ import annotations
+
+import pytest
+
+from src.live import chat_signals
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "LUL",
+        "kekw",
+        "OMEGALUL",
+        "lmao",
+        "lol",
+        "😂",
+        "💀",
+        "🔥",
+        "W",
+        "that was an L",
+        "?????",
+        "NO WAY",
+        "W stream",
+        ":rolling_on_the_floor_laughing:",
+        ":face_with_tears_of_joy:",
+        ":skull:",
+        ":fire:",
+    ],
+)
+def test_hype_tokens_are_recognised(text):
+    assert chat_signals.is_hype_message(text)
+
+
+@pytest.mark.parametrize(
+    "text", ["", "hello", "nice play", "GG", "ok?", "wow", "clip it"]
+)
+def test_ordinary_chat_is_not_hype(text):
+    assert not chat_signals.is_hype_message(text)
+
+
+def test_series_counts_rate_unique_authors_and_hype_share():
+    messages = [
+        (0.0, "a", "hello"),
+        (0.2, "b", "LUL"),
+        (0.9, "a", "KEKW"),
+        (1.5, "c", "nice"),
+        (2.1, "d", "W"),
+    ]
+
+    series = chat_signals.chat_series(messages, 3)
+
+    assert series["rate"] == [3, 1, 1]
+    assert series["unique"] == [2, 1, 1]
+    assert series["hype"] == pytest.approx([2 / 3, 0.0, 1.0])
+
+
+def test_seconds_are_ceiled_and_messages_outside_are_ignored():
+    messages = [
+        (-1.0, "a", "before"),
+        (0.0, "a", "LUL"),
+        (2.9, "b", "LUL"),
+        (3.0, "c", "after"),
+    ]
+
+    series = chat_signals.chat_series(messages, 2.2)
+
+    assert len(series["rate"]) == 3
+    assert series["rate"] == [1, 0, 1]
+    assert series["hype"] == [1.0, 0.0, 1.0]
+
+
+def test_empty_chat_is_all_zeroes():
+    series = chat_signals.chat_series([], 10)
+
+    assert series == {
+        "rate": [0] * 10,
+        "unique": [0] * 10,
+        "hype": [0.0] * 10,
+    }
+
+
+def test_zero_duration_has_no_seconds():
+    assert chat_signals.chat_series([(0.0, "a", "LUL")], 0) == {
+        "rate": [],
+        "unique": [],
+        "hype": [],
+    }
+
+
+def test_causal_zscores_lift_the_chat_burst_above_the_quiet_baseline():
+    messages = [(float(second), f"a{second % 7}", "hello") for second in range(400)]
+    for second in range(400, 406):
+        for index in range(15):
+            messages.append((second + index / 20.0, f"b{index}", "KEKW"))
+
+    series = chat_signals.chat_series(messages, 420)
+    z = chat_signals.chat_zscores(series)
+
+    assert set(z) == {"rate", "unique", "hype"}
+    assert all(len(values) == 420 for values in z.values())
+    assert z["rate"][400] > 3.0
+    assert z["unique"][400] > 3.0
+    assert z["hype"][400] > 3.0
+    assert abs(float(z["rate"][200])) < 0.01
+    assert all(float(z["rate"][index]) == 0.0 for index in range(20))
+
+
+def test_loaded_fixture_feeds_the_series_without_gaps():
+    from pathlib import Path
+
+    from src.live.chat_replay import load_messages
+
+    path = (
+        Path(__file__).resolve().parents[1]
+        / "fixtures"
+        / "chat"
+        / "sample_youtube.live_chat.json"
+    )
+    messages = load_messages(path)
+
+    series = chat_signals.chat_series(messages, messages[-1][0] + 1)
+
+    assert sum(series["rate"]) == len(messages)
+    assert all(0.0 <= share <= 1.0 for share in series["hype"])
+    assert max(series["rate"]) > 0
