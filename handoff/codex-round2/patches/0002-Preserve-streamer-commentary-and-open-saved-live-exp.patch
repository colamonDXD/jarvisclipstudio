@@ -0,0 +1,70 @@
+"""Save a finished live clip as an independently editable library clip."""
+import os
+from pathlib import Path
+import shutil
+import tempfile
+from uuid import NAMESPACE_URL, uuid5
+
+from sqlalchemy import func, insert, text
+
+from ..config import get_config
+from ..models import Task
+from ..repositories.clip_repository import ClipRepository
+from ..utils.async_helpers import run_in_thread
+
+
+def _copy_export(source: Path, target: Path):
+    target.parent.mkdir(parents=True, exist_ok=True)
+    with tempfile.NamedTemporaryFile(dir=target.parent, delete=False) as handle:
+        staged = Path(handle.name)
+    try:
+        shutil.copyfile(source, staged)
+        os.replace(staged, target)
+    finally:
+        staged.unlink(missing_ok=True)
+
+
+async def save_live_clip(db, user_id: str, clip_id: str):
+    row = (await db.execute(text(
+        "SELECT c.id,c.session_id,c.n,c.clip_path,c.duration,c.reason,s.url,s.settings "
+        "FROM live_clips c JOIN live_sessions s ON s.id=c.session_id "
+        "WHERE c.id=:id AND s.user_id=:uid AND c.status='ready' FOR UPDATE OF c"
+    ), {"id": clip_id, "uid": user_id})).mappings().first()
+    if not row:
+        return None
+    task_id = str(uuid5(NAMESPACE_URL, "snipnova:live-task:" + clip_id))
+    editor_id = str(uuid5(NAMESPACE_URL, "snipnova:live-clip:" + clip_id))
+    existing = await db.scalar(text(
+        "SELECT g.id FROM generated_clips g JOIN tasks t ON t.id=g.task_id "
+        "WHERE t.id=:task AND t.user_id=:uid AND g.id=:clip"
+    ), {"task": task_id, "uid": user_id, "clip": editor_id})
+    if existing:
+        return {"task_id": task_id, "clip_id": editor_id}
+    root = Path(os.getenv("TEMP_DIR") or get_config().temp_dir).resolve()
+    source = Path(row["clip_path"] or "").resolve()
+    if not source.is_relative_to(root / "live" / row["session_id"]) or not source.is_file():
+        return None
+    duration = float(row["duration"] or 0)
+    if duration <= 0:
+        return None
+    title = f"Live clip {row['n']}"
+    target = root / "clips" / task_id / f"{editor_id}.mp4"
+    await run_in_thread(_copy_export, source, target)
+    try:
+        await db.execute(text(
+            "INSERT INTO sources(id,type,title,url) VALUES (:id,'video_url',:title,:url) ON CONFLICT (id) DO NOTHING"
+        ), {"id": task_id, "title": title, "url": row["url"]})
+        await db.execute(insert(Task).values(
+            id=task_id, user_id=user_id, source_id=task_id, status="completed", progress=100,
+            completed_at=func.now(), generated_clips_ids=[editor_id],
+            source_metadata={"live_session_id": row["session_id"], "live_clip_id": clip_id},
+        ))
+        seconds = round(duration)
+        await ClipRepository.create_clip(db, task_id, target.name, str(target), "00:00",
+                                         f"{seconds // 60:02d}:{seconds % 60:02d}", duration, "", 0,
+                                         row["reason"] or "", 1, clip_id=editor_id)
+        await db.commit()
+    except Exception:
+        await db.rollback()
+        raise
+    return {"task_id": task_id, "clip_id": editor_id}
