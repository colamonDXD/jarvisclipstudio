+def remove_matching_dialogue(words: list, lines: dict) -> list:
+    """Suppress consecutive spoken words that also appear in a nearby subtitle line."""
+    def normalize(value):
+        return re.sub(r"[^\w]", "", str(value).casefold())
+
+    tokens = [normalize(w.get("text", "")) for w in words]
+    times = [float(w.get("start", 0)) / 1000 for w in words]
+    suppressed = set()
+    for sec, visible in lines.items():
+        near = [i for i, t in enumerate(times) if sec - 1.5 <= t < sec + 2.5]
+        for line in visible:
+            screen = [normalize(token) for token in line]
+            matcher = SequenceMatcher(None, [tokens[i] for i in near], screen, autojunk=False)
+            for start, offset, size in matcher.get_matching_blocks():
+                if size >= 2 and sum(len(s) for s in screen[offset:offset + size]) >= 6:
+                    suppressed.update(near[start:start + size])
+    return [word for i, word in enumerate(words) if i not in suppressed]
 
 
