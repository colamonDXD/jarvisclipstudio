@@ -0,0 +1,49 @@
+"""Install a local faster-whisper snapshot and CUDA 12 libraries in the live worker's speech volume."""
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+
+def run(*args):
+    subprocess.run(["docker", *map(str, args)], check=True)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("model", type=Path, help="Local CTranslate2 Whisper snapshot with model.bin and tokenizer.json")
+    parser.add_argument("--project", default="jarvisclipstudio")
+    args = parser.parse_args()
+    model = args.model.resolve(strict=True)
+    required = ["model.bin", "tokenizer.json", "config.json"]
+    if not all((model / name).is_file() for name in required):
+        parser.error("The selected snapshot lacks a required Whisper file.")
+    volume = args.project + "_speech_runtime"
+    image = "snipnova-whisper-cu12-runtime"
+    with tempfile.TemporaryDirectory() as directory:
+        recipe = Path(directory) / "Dockerfile"
