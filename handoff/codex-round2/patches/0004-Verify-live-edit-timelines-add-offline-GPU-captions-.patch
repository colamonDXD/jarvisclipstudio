+def edited_captions(result, source_start, duration, teaser):
+    """Place words on both occurrences of a cold-open payoff in playback order."""
+    if teaser is None:
+        return slice_result(result, source_start, source_start + duration)
+    relative_start, length = teaser
+    spans = [(source_start + relative_start, length, 0), (source_start, duration - length, length)]
+    segments = []
