diff --git a/backend/src/live/context_picker.py b/backend/src/live/context_picker.py
new file mode 100644
index 0000000..fe7acd2
--- /dev/null
+++ b/backend/src/live/context_picker.py
@@ -0,0 +1,46 @@
+"""Rerank reaction candidates using the lead-in and the following 30 seconds of audio."""
+import json
+from functools import lru_cache
+from pathlib import Path
+
+import numpy as np
+
+
+def context_features(series, moments):
+    """Normalize within a recording so different microphones share the same scale."""
+    tracks = []
+    for key in ("vocal", "f0", "laugh", "voiced_frac"):
+        raw = np.nan_to_num(np.asarray(series[key], dtype=float))
+        median = np.median(raw)
+        spread = max(0.01, np.percentile(raw, 90) - np.percentile(raw, 10))
+        tracks.append(np.clip((raw - median) / spread, -5, 5))
+    rows = []
+    for m in moments:
+        i = int(m["onset"])
+        row = [np.log1p(max(0, m["score"])), m["talk"], np.log1p(m["end"] - i)]
+        for data in tracks:
+            for lo, hi in ((-15, -4), (-4, 1), (0, 5), (5, 15), (15, 30)):
+                frame = data[max(0, i + lo):max(0, i + hi)]
+                row.extend((frame.mean(), frame.max()) if frame.size else (0, 0))
+        rows.append(row)
+    return np.asarray(rows)
+
+
+@lru_cache(maxsize=1)
+def _model():
+    return json.loads(Path(__file__).with_name("context_picker_weights.json").read_text())
+
+
+def rerank(series, moments, model=None):
+    if len(moments) < 2 or any(not len(series.get(k, [])) for k in ("vocal", "f0", "laugh", "voiced_frac")):
+        return moments
+    model = _model() if model is None else model
+    x = context_features(series, moments)
+    def standardize(a):
+        return (a - a.mean()) / max(0.001, a.std())
+    mix = model["mix"]
+    predicted = (1 - mix) * standardize(x[:, 0]) + mix * standardize(x @ model["weights"])
+    # Preserve the score distribution expected by the downstream replay-heat boost.
+    scores = sorted((m["score"] for m in moments), reverse=True)
+    order = np.argsort(-predicted, kind="stable")
+    return [dict(moments[i], score=score) for i, score in zip(order, scores)]
