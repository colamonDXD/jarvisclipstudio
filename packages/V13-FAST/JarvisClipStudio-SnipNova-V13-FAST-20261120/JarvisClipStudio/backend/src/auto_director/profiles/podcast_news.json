{
  "niche": "podcast_news",
  "pacing": {
    "target_cuts_per_min": [10, 15],
    "silence_trim_aggressive": true,
    "min_shot_sec": 4.0,
    "max_shot_sec": 6.0
  },
  "transitions": {
    "default": "hard_cut",
    "duration_sec": 0.05,
    "on_topic_change": "hard_cut",
    "on_punchline": "hard_cut",
    "signature": {"name": "fade", "duration_sec": 0.3}
  },
  "zooms": {
    "punch_in_scale": 1.25,
    "punch_in_trigger": "emphasis",
    "ken_burns": false
  },
  "captions": {
    "preset_id": "hormozi",
    "words_per_line": 3,
    "position": "bottom"
  },
  "overlays": {
    "info_cards": true,
    "lower_thirds": true,
    "reference_images": "open_web",
    "ref_image_at_entity_mentions": true
  },
  "broll": {
    "enabled": true,
    "source": "stock",
    "density_per_min": 1.5,
    "cadence_per_min": 3.5,
    "layout": "cutaway"
  },
  "audio": {
    "music_mood": "none",
    "music_volume_0_to_1": 0.0,
    "ducking_db": 0.0,
    "sfx_from_user_library": false
  },
  "color": {
    "lut": "none"
  },
  "hook": {
    "title_style": "curiosity_gap",
    "title_seconds": 2.0
  },
  "scene_rules": {
    "speaker_punch_in": {
      "enabled": true,
      "min_turn_sec": 1.2,
      "min_gap_sec": 3.0,
      "max_per_clip": 6
    }
  }
}